"""
Deploy script for the 2026-05-29 session (Rounds 1-5 from audit_2026-05-28.md).

Uploads (in three waves):

  Wave 1 — HTML/static + .htaccess (no opcache reset needed):
    * 6 Impact theme templates with this session's design changes
    * .htaccess with Apache 2.2/2.4-compatible defense-in-depth FilesMatch

  Wave 2 — PHP classes (will need OPcache reset after):
    * visibility.class.php  — added sqlWhitelistColumns + filterUserRow helpers
    * visibility_filter.class.php — architecture-model docstring at top
    * match_score.class.php — field-name mapping reference + privacy invariant
    * match_scores.php — privacy invariant docstring

  Wave 3 — one-shot probe:
    * _mgs_probe_onboarding_options_2026_05_28.php
      Token-protected, deploy + run + delete after.

Run:
    $env:PROD_PASS = '<production FTPS password>'
    python d:\MyProjects\Irene\Irene\Irene\site\deploy_2026_05_29.py

After upload, see the "Next steps" output printed at the end.

Pure-FTPd on meetgreeksingles.com requires SSL session reuse between the
control and data channels; the FTP_TLS_Reuse subclass below patches stock
ftplib.FTP_TLS to do that.
"""

import sys, os, ftplib, ssl

# UTF-8 stdout — needed if any uploaded path contains non-ASCII.
sys.stdout.reconfigure(encoding="utf-8", errors="replace")


class FTP_TLS_Reuse(ftplib.FTP_TLS):
    """Pure-FTPd reuses the SSL session for the data channel."""
    def ntransfercmd(self, cmd, rest=None):
        conn, size = ftplib.FTP.ntransfercmd(self, cmd, rest)
        if self._prot_p:
            conn = self.context.wrap_socket(
                conn,
                server_hostname=self.host,
                session=self.sock.session,
            )
        return conn, size


HOST = "meetgreeksingles.com"
USER = "everett@meetgreeksingles.com"
REMOTE_ROOT = "/public_html"

# Source folders
LOCAL_UPSTREAM = r"d:\MyProjects\Irene\Irene\Irene\site\upstream"
LOCAL_SITE     = r"d:\MyProjects\Irene\Irene\Irene\site"

# .htaccess LAST in wave 1 — if a typo 500s the site, the previous files
# at least uploaded successfully, so rollback is just one file.
WAVE_1 = [
    "_frameworks/main/impact/_header.html",
    "_frameworks/main/impact/_footer.html",
    "_frameworks/main/impact/index.html",
    "_frameworks/main/impact/login.html",
    "_frameworks/main/impact/register.html",
    "_frameworks/main/impact/events.html",
    ".htaccess",
]

WAVE_2 = [
    "_include/current/visibility.class.php",
    "_include/current/visibility_filter.class.php",
    "_include/current/match_score.class.php",
    "match_scores.php",
]

WAVE_3_PROBE = "_mgs_probe_onboarding_options_2026_05_28.php"
OPCACHE_TOKEN = "429924c65fda7a12ff86d2c73eb838bc"


def ensure_dir(ftp, path):
    """Create directories along path if missing. Idempotent."""
    if not path:
        return
    cur = ""
    for p in path.split("/"):
        cur = cur + "/" + p if cur else p
        try:
            ftp.mkd(cur)
        except ftplib.error_perm:
            pass  # exists


def upload(ftp, local_path, remote_rel):
    """Upload one file with the root-file safety pattern from 5.11_prompt.md."""
    parts = remote_rel.strip("/").split("/")
    name = parts.pop()
    if parts:
        ensure_dir(ftp, "/".join(parts))
        ftp.cwd(REMOTE_ROOT + "/" + "/".join(parts))
    else:
        ftp.cwd(REMOTE_ROOT)
    print(f"  -> {remote_rel}")
    with open(local_path, "rb") as f:
        ftp.storbinary(f"STOR {name}", f)
    ftp.cwd(REMOTE_ROOT)


def main():
    password = os.environ.get("PROD_PASS")
    if not password:
        print("ERROR: set $env:PROD_PASS before running this script.")
        sys.exit(1)

    print(f"Connecting to {HOST} ...")
    ftp = FTP_TLS_Reuse(HOST)
    ftp.login(USER, password)
    ftp.prot_p()
    ftp.cwd(REMOTE_ROOT)
    print(f"Logged in. cwd={REMOTE_ROOT}\n")

    print("=== Wave 1: HTML/static (no OPcache reset needed) ===")
    for rel in WAVE_1:
        local = os.path.join(LOCAL_UPSTREAM, rel.replace("/", os.sep))
        if not os.path.exists(local):
            print(f"  SKIP — missing local: {local}")
            continue
        upload(ftp, local, rel)

    print("\n=== Wave 2: PHP classes (OPcache reset required after) ===")
    for rel in WAVE_2:
        local = os.path.join(LOCAL_UPSTREAM, rel.replace("/", os.sep))
        if not os.path.exists(local):
            print(f"  SKIP — missing local: {local}")
            continue
        upload(ftp, local, rel)

    print("\n=== Wave 3: one-shot probe (read-only; delete after running) ===")
    probe_local = os.path.join(LOCAL_SITE, WAVE_3_PROBE)
    if os.path.exists(probe_local):
        upload(ftp, probe_local, WAVE_3_PROBE)
    else:
        print(f"  SKIP — probe not found at {probe_local}")

    ftp.quit()

    print("\n" + "=" * 60)
    print("DEPLOY UPLOAD COMPLETE")
    print("=" * 60)
    print("\nNext steps (run these in PowerShell):\n")
    print("  # 1. Verify homepage still loads (must be HTTP 200)")
    print('  curl.exe -sI "https://meetgreeksingles.com/"')
    print()
    print("  # 2. Reset OPcache for the PHP class changes")
    print(f'  curl.exe "https://meetgreeksingles.com/_mgs_opc.php?token={OPCACHE_TOKEN}"')
    print()
    print("  # 3. Run the onboarding-options probe + save output")
    print(f'  curl.exe "https://meetgreeksingles.com/{WAVE_3_PROBE}?token={OPCACHE_TOKEN}" > "_archive\\reports\\onboarding_probe_2026_05_29.txt"')
    print()
    print("  # 4. Delete the probe from production")
    print( "  python d:\\MyProjects\\Irene\\Irene\\Irene\\site\\_delete_probe_2026_05_29.py")
    print()
    print("  # 5. Smoke test (31 URLs)")
    print( "  python d:\\MyProjects\\Irene\\Irene\\Irene\\site\\_e2e_recheck_2026_05_03.py")


if __name__ == "__main__":
    main()
