{header}
<script>
	messages.setLastId('{last_id}');
    messages.initOneChat('{user_to}', '{limit_start}', '{is_one_chat}', '{user_to_photo}', '{first_msg_id}');
    messages.usersCacheAdd('{user_to_id}');
</script>
<style>
/* 2026-06-11 (per Irene's review) — Modernized direct-message UI.
   IMPORTANT: every rule is scoped to .mgs_msg_one wrapper so nothing leaks
   into other pages. No `body` or unscoped `.col_center` rules. */

/* Card header */
.mgs_msg_one .head.icon_head_messages {
    max-width: 760px;
    margin: 32px auto 0 !important;
    background: #ffffff !important;
    border-radius: 22px 22px 0 0 !important;
    padding: 22px 28px !important;
    border-bottom: 1px solid #e8e1d2 !important;
    background-image: none !important;
    position: relative !important;
    text-align: left !important;
    height: auto !important;
    line-height: 1.3 !important;
    box-shadow: 0 -8px 32px rgba(15, 58, 106, 0.06) !important;
}
.mgs_msg_one .head.icon_head_messages > a {
    font-family: 'Playfair Display', Georgia, serif !important;
    font-size: 22px !important;
    font-weight: 600 !important;
    color: #0f3a6a !important;
    text-decoration: none !important;
    line-height: 1.2 !important;
}
.mgs_msg_one .head.icon_head_messages > a:hover { color: #1e3a8a !important; text-decoration: none !important; }
.mgs_msg_one .head.icon_head_messages > a::before {
    content: '';
    display: inline-block;
    width: 8px; height: 8px;
    border-radius: 50%;
    background: #22c55e;
    margin-right: 10px;
    vertical-align: middle;
    box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.18);
}
.mgs_msg_one .icon_message_back {
    position: absolute !important;
    right: 22px !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    width: 36px !important;
    height: 36px !important;
    border-radius: 999px !important;
    background: #f4f7fa !important;
    cursor: pointer !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    transition: background 0.15s !important;
}
.mgs_msg_one .icon_message_back:hover { background: #e8eef4 !important; }
.mgs_msg_one .icon_message_back .back,
.mgs_msg_one .icon_message_back .back_hover {
    width: 12px !important; height: 12px !important;
    background: none !important;
    border: solid #0f3a6a;
    border-width: 2px 0 0 2px !important;
    transform: rotate(-45deg);
    margin-left: 3px;
}
.mgs_msg_one .icon_message_back .back_hover { display: none !important; }

/* Conversation + composer container — itself must be ~1000px tall */
.mgs_msg_one #bl_cont.cont {
    max-width: 760px !important;
    margin: 0 auto !important;
    background: #ffffff !important;
    border-radius: 0 0 22px 22px !important;
    border: 1px solid #e8e1d2 !important;
    border-top: none !important;
    box-shadow: 0 8px 24px rgba(15, 58, 106, 0.06) !important;
    padding: 0 !important;
    overflow: hidden !important;
    position: relative !important;
    z-index: 1 !important;
    min-height: 900px !important;
    display: flex !important;
    flex-direction: column !important;
}

/* Clear separation between the conversation card and the footer below.
   Adds an explicit gap so the navy footer band cannot visually overlap
   the message composer, plus a min-height so short conversations still
   give the page a comfortable vertical presence. */
.mgs_msg_one {
    padding-bottom: 56px !important;
    min-height: 1000px !important;
    position: relative !important;
    z-index: 1 !important;
    box-sizing: border-box !important;
}
.mgs_msg_one::after {
    content: '';
    display: block;
    clear: both;
    height: 0;
}

/* Conversation area */
.mgs_msg_one .message_chat_scroll {
    background: linear-gradient(180deg, #fbf8f2 0%, #ffffff 100%) !important;
    border-radius: 0 !important;
}
.mgs_msg_one #bl_viewport {
    max-height: 760px !important;
    min-height: 720px !important;
    flex: 1 1 auto !important;
}
.mgs_msg_one .scrollbarY.message_chat_scroll {
    flex: 1 1 auto !important;
    min-height: 720px !important;
}
.mgs_msg_one .message_chat { padding: 22px 22px 6px !important; }
.mgs_msg_one .chat_cont { padding: 0 !important; }
.mgs_msg_one #msg_profile_pic.msg_profile_pic { display: none !important; }

/* Message bubbles */
.mgs_msg_one .im_msg_one,
.mgs_msg_one .chat_cont .item {
    margin-bottom: 14px !important;
    display: flex !important;
    align-items: flex-end !important;
    gap: 10px !important;
}
.mgs_msg_one .chat_cont .item.answer,
.mgs_msg_one .chat_cont .item.your { flex-direction: row-reverse !important; }
.mgs_msg_one .chat_cont .item.alien,
.mgs_msg_one .chat_cont .item.opponent { flex-direction: row !important; }

.mgs_msg_one .chat_cont .item .pic {
    width: 34px !important;
    height: 34px !important;
    min-width: 34px !important;
    border-radius: 50% !important;
    overflow: hidden !important;
    margin: 0 !important;
}
.mgs_msg_one .chat_cont .item .pic button {
    width: 100% !important;
    height: 100% !important;
    border-radius: 50% !important;
    background-size: cover !important;
    background-position: center !important;
    border: none !important;
    padding: 0 !important;
    cursor: pointer !important;
    background-color: #f7f3ec !important;
}

.mgs_msg_one .chat_cont .item .msg {
    max-width: 70% !important;
    display: flex !important;
    flex-direction: column !important;
}
.mgs_msg_one .chat_cont .item .msg .info,
.mgs_msg_one .chat_cont .item .info {
    background: #ffffff !important;
    padding: 12px 16px !important;
    border-radius: 18px !important;
    font-family: 'Source Sans 3', system-ui, sans-serif !important;
    font-size: 15px !important;
    line-height: 1.45 !important;
    color: #1f2937 !important;
    border: 1px solid #e8e1d2 !important;
    box-shadow: 0 2px 6px rgba(15, 58, 106, 0.04) !important;
    word-wrap: break-word !important;
    overflow-wrap: break-word !important;
}
.mgs_msg_one .chat_cont .item.answer .msg .info,
.mgs_msg_one .chat_cont .item.your .msg .info {
    background: #1e3a8a !important;
    color: #e6c069 !important;
    border-color: #b88a3e !important;
    border-radius: 18px 18px 4px 18px !important;
    box-shadow: 0 4px 12px rgba(30, 58, 138, 0.18) !important;
}
.mgs_msg_one .chat_cont .item.alien .msg .info,
.mgs_msg_one .chat_cont .item.opponent .msg .info {
    background: #f7f3ec !important;
    color: #1f2937 !important;
    border-radius: 18px 18px 18px 4px !important;
}

.mgs_msg_one .chat_cont .item .data,
.mgs_msg_one .chat_cont .item .date_msg {
    font-family: 'Source Sans 3', system-ui, sans-serif !important;
    font-size: 11px !important;
    color: #5b6471 !important;
    margin: 4px 12px 0 !important;
    opacity: 1 !important;
}

/* Composer — give the textarea proper left breathing room and keep the row
   on a single line so the camera button stays inline with Send. */
.mgs_msg_one .message_field_chat {
    background: #ffffff !important;
    padding: 14px 28px 18px 36px !important;
    border-top: 1px solid #e8e1d2 !important;
    display: flex !important;
    flex-wrap: nowrap !important;
    align-items: center !important;
    gap: 12px !important;
    position: relative !important;
}
.mgs_msg_one .message_field_chat #msg_text,
.mgs_msg_one .message_field_chat textarea {
    flex: 1 1 auto !important;
    width: auto !important;
    min-height: 44px !important;
    max-height: 120px !important;
    padding: 12px 16px !important;
    border: 1.5px solid #e8e1d2 !important;
    border-radius: 22px !important;
    background: #f7f3ec !important;
    color: #1f2937 !important;
    font-family: 'Source Sans 3', system-ui, sans-serif !important;
    font-size: 14.5px !important;
    line-height: 1.45 !important;
    resize: none !important;
    transition: border-color 0.15s, background 0.15s, box-shadow 0.15s !important;
    box-sizing: border-box !important;
}
.mgs_msg_one .message_field_chat #msg_text:focus,
.mgs_msg_one .message_field_chat textarea:focus {
    outline: none !important;
    border-color: #b88a3e !important;
    background: #ffffff !important;
    box-shadow: 0 0 0 3px rgba(184, 138, 62, 0.12) !important;
}
.mgs_msg_one .message_field_chat #msg_text::placeholder { color: #94a3b8 !important; }

.mgs_msg_one .pp_message_upload_img {
    width: 42px !important;
    height: 42px !important;
    min-width: 42px !important;
    border-radius: 50% !important;
    background: #f7f3ec !important;
    border: 1.5px solid #e8e1d2 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    color: #0f3a6a !important;
    cursor: pointer !important;
    transition: background 0.15s, border-color 0.15s !important;
    flex-shrink: 0 !important;
    position: relative !important;
    margin: 0 !important;
    padding: 0 !important;
}
.mgs_msg_one .pp_message_upload_img:hover {
    background: #f7f3ec !important;
    border-color: #b88a3e !important;
    color: #1e3a8a !important;
}
.mgs_msg_one .pp_message_upload_img i.fa-camera {
    font-size: 16px !important;
    color: inherit !important;
}
.mgs_msg_one .pp_message_upload_img.disabled { opacity: 0.5 !important; cursor: not-allowed !important; }

/* Send button — brand pill */
.mgs_msg_one .message_field_chat .send_btn,
.mgs_msg_one .message_field_chat button[type="submit"],
.mgs_msg_one .message_field_chat .btn.btn-primary {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
    height: 44px !important;
    min-width: 120px !important;
    padding: 0 22px !important;
    background: #1e3a8a !important;
    color: #e6c069 !important;
    border: 2px solid #b88a3e !important;
    border-radius: 999px !important;
    font-family: 'Source Sans 3', system-ui, sans-serif !important;
    font-size: 13px !important;
    font-weight: 800 !important;
    letter-spacing: 1.2px !important;
    text-transform: uppercase !important;
    cursor: pointer !important;
    box-shadow: 0 6px 16px rgba(30, 58, 138, 0.22) !important;
    transition: background 0.2s, border-color 0.2s, transform 0.15s !important;
    flex-shrink: 0 !important;
}
.mgs_msg_one .message_field_chat .send_btn:hover,
.mgs_msg_one .message_field_chat button[type="submit"]:hover {
    background: #1e4498 !important;
    border-color: #e6c069 !important;
    transform: translateY(-1px) !important;
}
.mgs_msg_one .message_field_chat .send_btn::after {
    content: '\2192';
    font-size: 14px;
    line-height: 1;
    margin-left: 2px;
}

/* Scrollbar */
.mgs_msg_one .scrollbarY.message_chat_scroll .scrollbar { right: 8px !important; }
.mgs_msg_one .scrollbarY.message_chat_scroll .scrollbar .thumb {
    background: rgba(15, 58, 106, 0.20) !important;
    border-radius: 999px !important;
    width: 5px !important;
}

.mgs_msg_one .more_load_cont_im { padding: 12px 0 !important; }

@media (max-width: 720px) {
    .mgs_msg_one .head.icon_head_messages,
    .mgs_msg_one #bl_cont.cont { margin-left: 12px !important; margin-right: 12px !important; }
    .mgs_msg_one .head.icon_head_messages { padding: 18px 20px !important; }
    .mgs_msg_one .head.icon_head_messages > a { font-size: 19px !important; }
    .mgs_msg_one .message_chat { padding: 18px 16px 6px !important; }
    .mgs_msg_one .chat_cont .item .msg { max-width: 78% !important; }
    .mgs_msg_one .message_field_chat { padding: 12px 14px 14px !important; flex-wrap: wrap !important; }
    .mgs_msg_one .message_field_chat .send_btn { min-width: 100px !important; padding: 0 16px !important; }
}
</style>

<div class="col_center mgs_msg_one">
	<div class="head icon_head_messages head_line">
        <a href="" onclick="goLink('{url_main}{url_profile}', 'ref=one_chat'); return false;">{user_to_name}</a>
        <span class="icon_message_back" onclick="redirectUrl('{url_main}{url_page_messages}')">
            <span class="back"></span>
            <span class="back_hover"></span>
        </span>
    </div>
    <div id="bl_cont" class="cont" style="opacity:0;">
        <div class="scrollbarY message_chat_scroll">
            <div class="scrollbar"><div class="track"><div id="scrollbarY_thumb" class="thumb animate"></div></div></div>
            <div id="bl_viewport" class="viewport">
                <div id="bl_overview" class="overview">
                    <div class="message_chat">
                        <div id="chat_cont" class="chat_cont">
                            <div id="more_load_cont_im" class="css_loader more_load_cont_im">
                                <div class="spinner center">
                                <div class="spinner-blade"></div>
                                <div class="spinner-blade"></div>
                                <div class="spinner-blade"></div>
                                <div class="spinner-blade"></div>
                                <div class="spinner-blade"></div>
                                <div class="spinner-blade"></div>
                                <div class="spinner-blade"></div>
                                <div class="spinner-blade"></div>
                                <div class="spinner-blade"></div>
                                <div class="spinner-blade"></div>
                                <div class="spinner-blade"></div>
                                <div class="spinner-blade"></div>
                                </div>
                            </div>
                            <div id="msg_profile_pic" class="msg_profile_pic <!-- begin_one_chat_profile_pic_hide -->hide<!-- end_one_chat_profile_pic_hide -->">
                                <div class="profile_pic">
                                    <button <!-- begin_messages_users_list_item_plug_private_photos -->class="plug_private_photos"<!-- end_messages_users_list_item_plug_private_photos --> onclick="goLink('{url_main}{url_profile}', 'ref=one_chat'); return false;" style="background-image: url({url_files}{user_to_photo});" title=""></button>
                                </div>

                            </div>
                            {users_list}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="message_field_chat">
            <textarea id="msg_text" class="placeholder" placeholder="Write a thoughtful message..."></textarea>
            <button type="submit" class="send_btn btn btn-primary">Send</button>
            <div id="pp_message_upload_img" title="{a_upload_image}" class="pp_message_upload_img disabled" onclick="messages.clearUploadImage(true, true);">
                <div id="pp_message_upload_img_loader" class="pp_message_upload_img_loader"></div>
                <i class="fa fa-camera" aria-hidden="true"></i>
                <!-- <span class="count_upload_image">1</span> -->
                <span class="count_upload_image">
                    <i class="fa fa-check"></i>
                    <i class="fa fa-times" aria-hidden="true"></i>
                </span>
                <form id="pp_message_upload_img_frm" method="post" enctype="multipart/form-data" action="" onsubmit="return false;">
                    <input class="pp_message_upload_img_input_file" type="file" accept="image/jpg,image/jpeg,image/png,image/gif" name="file_add_wall"  onclick="messages.clickUpload($(this));" onChange="messages.changeUploadImage($(this));"/>
                    <input class="inp_hide" type="reset" value=""/>
                    <input class="inp_hide" type="submit" value=""/>
                </form>
                <script>messages.initAddImage();</script>
            </div>
        </div>
        <div class="cl"></div>
	</div>
</div>
<div style="display:none;">
	<div id="template_msg" class="im_msg_one" data-send="{message_send}" data-id="" data-msg-user-id="" data-to-user-id="" data-sp="">
		<div class="item answer">
			<div class="data">
				<span class="date_msg" style="opacity:0;">&nbsp;</span>
				<div class="msg_read hide"></div>
				<div class="upgrade_msg hide">{l_upgrade_to_see_if_read}</div>
			</div>
			<div class="msg">
				<div class="info"></div>
				<div class="pic" onclick="redirectUrl('{url_main}{message_user_profile_link}')">
					<button title="" style="background-image: url({url_files}{current_user_photo});"></button>
				</div>
			</div>
		</div>
    </div>
</div>
{footer}