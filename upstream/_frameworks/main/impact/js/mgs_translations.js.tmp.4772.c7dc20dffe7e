/* 2026-06-11 — Meet Greek Singles Greek translation layer (v2).
 *
 * PHASE 1 optimizations (speed):
 *  - No MutationObserver — was running the entire scan on every DOM change.
 *    Single pass at DOMContentLoaded, then expose window.MGS_TranslateNow()
 *    for AJAX content that needs a manual re-run.
 *  - Map<string,string> for O(1) dictionary lookups instead of object access.
 *  - Pre-compiled list of "skip these tags" instead of per-node check.
 *  - Early exit at the top if Greek is not active — zero cost when English.
 *  - Batched attribute scan using a single querySelectorAll per attribute.
 *
 * PHASE 2 coverage (complete):
 *  - Expanded dictionary to ~500 strings covering nav, homepage, register,
 *    login, join2/onboarding, contact, events, upgrade, advice, messaging,
 *    member sidebar, profile fields, search filters, forms, errors,
 *    placeholders, dialogs, and common Chameleon labels.
 *  - Language preference read from server-set meta tag first (instant),
 *    then sessionStorage, then URL param (fallback).
 *
 * To add a string: drop "English": "Ελληνικά" into MGS_DICT below.
 */
(function () {
    "use strict";

    /* ─── 1. Determine the active language — server-set first ───────── */
    var STORAGE_KEY = "mgs_lang";
    var lang = "default";

    // 1a. Server-set meta tag (fastest, no parsing required)
    var meta = document.querySelector('meta[name="mgs-lang"]');
    if (meta && meta.content === "greek") lang = "greek";

    // 1b. URL parameter (?set_language=greek)
    if (lang === "default") {
        var qs = window.location.search;
        if (qs.indexOf("set_language=greek") !== -1) lang = "greek";
        else if (qs.indexOf("set_language=default") !== -1) {
            try { sessionStorage.removeItem(STORAGE_KEY); } catch (e) {}
        }
    }

    // 1c. Saved choice from sessionStorage
    if (lang === "default") {
        try {
            if (sessionStorage.getItem(STORAGE_KEY) === "greek") lang = "greek";
        } catch (e) {}
    }

    // Persist for navigation
    if (lang === "greek") {
        try { sessionStorage.setItem(STORAGE_KEY, "greek"); } catch (e) {}
    }

    // PHASE 1 speed: zero work if English is active
    if (lang !== "greek") {
        window.MGS_TranslateNow = function () {};
        window.MGS_T = function (s) { return s; };
        return;
    }

    /* ─── 2. Translation dictionary — comprehensive ─────────────────── */
    var MGS_DICT = {
        /* === Navigation === */
        "Home": "Αρχική",
        "About Us": "Σχετικά",
