    // Build a Map for O(1) lookups (faster than object access)
    var dict = new Map();
    var k;
    for (k in MGS_DICT) {
        if (Object.prototype.hasOwnProperty.call(MGS_DICT, k)) {
            dict.set(k, MGS_DICT[k]);
        }
    }

    /* ─── 3. Tags to skip during text node walk ─────────────────────── */
    var SKIP_TAGS = {
        SCRIPT: 1, STYLE: 1, NOSCRIPT: 1,
        CODE: 1, PRE: 1, TEXTAREA: 1, IFRAME: 1
    };

    /* ─── 4. Text node walker — single pass, no re-runs ─────────────── */
    function translateTextNodes(root) {
        var walker = document.createTreeWalker(
            root,
            NodeFilter.SHOW_TEXT,
            {
                acceptNode: function (node) {
                    var p = node.parentNode;
                    if (!p || SKIP_TAGS[p.tagName]) return NodeFilter.FILTER_REJECT;
                    var v = node.nodeValue;
                    if (!v || v.length < 2) return NodeFilter.FILTER_REJECT;
                    // Quick check: skip nodes that are pure whitespace
                    if (!/\S/.test(v)) return NodeFilter.FILTER_REJECT;
                    return NodeFilter.FILTER_ACCEPT;
                }
            }
        );

        var n;
        while ((n = walker.nextNode())) {
            var orig = n.nodeValue;
            var trimmed = orig.replace(/^\s+|\s+$/g, "");
            if (!trimmed) continue;

            // Direct dictionary hit
            if (dict.has(trimmed)) {
                n.nodeValue = orig.replace(trimmed, dict.get(trimmed));
                continue;
            }

            // Trim trailing colon (common in form labels like "Email:")
            if (trimmed.charAt(trimmed.length - 1) === ":") {
                var noColon = trimmed.slice(0, -1);
                if (dict.has(noColon)) {
                    n.nodeValue = orig.replace(trimmed, dict.get(noColon) + ":");
                    continue;
                }
            }

            // Smart fallback for copyright lines (any year)
            // Matches: © 2025 Meet Greek Singles. All rights reserved.
            var copyMatch = trimmed.match(/^[©Ⓒ]\s*(\d{4})\s+Meet\s+Greek\s+Singles\.\s+All\s+rights\s+reserved\.?$/i);
            if (copyMatch) {
                n.nodeValue = orig.replace(
                    trimmed,
                    "© " + copyMatch[1] + " Meet Greek Singles. Με την επιφύλαξη παντός δικαιώματος."
                );
            }
        }
    }

    /* ─── 5. Attribute translation — batched ────────────────────────── */
    var ATTRS = ["placeholder", "title", "alt", "aria-label"];
    function translateAttributes(root) {
        for (var i = 0; i < ATTRS.length; i++) {
            var attr = ATTRS[i];
            var els = root.querySelectorAll("[" + attr + "]");
            for (var j = 0; j < els.length; j++) {
                var v = els[j].getAttribute(attr);
                if (v && dict.has(v)) {
                    els[j].setAttribute(attr, dict.get(v));
                }
            }
        }
    }

    /* ─── 6. Main run + AJAX hook ───────────────────────────────────── */
    function run(root) {
        try {
            translateTextNodes(root || document.body);
            translateAttributes(root || document.body);
        } catch (e) {
            if (window.console && console.warn) {
                console.warn("[MGS i18n]", e);
            }
        }
    }

    // Expose for AJAX-loaded content to call after insertion
    window.MGS_TranslateNow = run;
    window.MGS_T = function (s) { return dict.has(s) ? dict.get(s) : s; };

    // Run multiple times to catch late-rendered content (formstyler, dropdowns,
    // search-result AJAX, etc.) without the heavy MutationObserver cost.
    function runAll() { run(); }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", runAll);
    } else {
        runAll();
    }

    // After window.load (when formstyler has rendered its styled selects)
    window.addEventListener("load", runAll);

    // Final pass to catch anything inserted by jQuery $(document).ready()
    // handlers that fire after window.load (rare but happens)
    setTimeout(runAll, 600);
    setTimeout(runAll, 1500);
})();
