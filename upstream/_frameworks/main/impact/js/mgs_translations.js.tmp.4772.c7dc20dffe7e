        "Sign Up": "Εγγραφή",
        "Register": "Εγγραφή",
        "Log out": "Αποσύνδεση",
        "Logout": "Αποσύνδεση",
        "Sign Out": "Αποσύνδεση",
        "Settings": "Ρυθμίσεις",
