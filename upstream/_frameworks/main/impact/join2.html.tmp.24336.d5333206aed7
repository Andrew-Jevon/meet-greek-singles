{header}
<script type="text/javascript" src="{url_tmpl_main}js/join.js{cache_version_param}"></script>
<script>
    var joinLangParts = {
        incorrect_captcha : '{j_incorrect_captcha}',
        done : '{j_done}',
        errorFileSizeLimit : '{max_photo_file_size_limit}',
        acceptFileTypes : '{j_accept_file_types}',
        errorFileUploadFailed : '{j_photo_file_upload_failed}',
        noConfirmationAccount : '{j_no_confirmation_account}',
        existsEmail : '{j_exists_email}',
        unlike : '{j_unlike}',
        like : '{j_like}',
        slogan_1 : '{slogan_1}',
        slogan_2 : '{slogan_2}',
        slogan_3 : 'A few finishing touches to your story',
    };
    var isJoinWithPhotoOnly='{join_with_photo_only}'*1,
        fileSizeLimit='{photo_file_size_limit}'*1,
        numberPhotoLikes='{number_photo_likes}'*1,
        maxUsersPagesJoin='{usersinfo_pages_per_join}'*1;
    var captcha='',isRecaptcha=false;
    <!-- begin_re_captcha_js -->
    isRecaptcha=true;
    var onloadCallback = function() {
        recaptchaWd = grecaptcha.render('recaptcha', {
            'sitekey' : '{re_captcha_sitekey}',
            'callback' : verifyCallback,
            'theme' : '{re_captcha_theme}'
        });
    };
    <!-- end_re_captcha_js -->
    fileNameUpload = '{social_photo_uploaded_name}';
</script>

<style>
    :root {
        --mgs-navy: #0f3a6a;
        --mgs-gold: #c89a3a;
        --mgs-ink: #1f2937;
        --mgs-ink-soft: #5b6471;
    }

    /* Background + layout shell */
    html body .wrap_header_cont,
    html body .wrap_header_cont.absolute {
        position: relative !important;
        width: 100% !important;
        max-width: 100% !important;
        height: auto !important;
        min-height: 100vh !important;
        margin: 0 !important;
        padding: 0 !important;
        background: url(/_files/banner/ChangedBackgroundImage.png?v=2026-06-01) center center / cover no-repeat !important;
        z-index: 1 !important;
    }
    html body .wrap_header_cont > .bl {
        width: 100% !important;
        max-width: 100% !important;
        padding: 0 !important;
        margin: 0 !important;
    }

    .mgs_join2_legacy_header { display: none !important; }

    /* Footer-injected homepage video block — never show on join2 */
    html body:has(.mgs_join2_shell) .wrap_header_cont + .header,
    html body:has(.mgs_join2_shell) .header {
        display: none !important;
        visibility: hidden !important;
        height: 0 !important;
        min-height: 0 !important;
        max-height: 0 !important;
        overflow: hidden !important;
        margin: 0 !important;
        padding: 0 !important;
        pointer-events: none !important;
        background: none !important;
    }
    html body:has(.mgs_join2_shell) .header video,
    html body:has(.mgs_join2_shell) .header .video-wrapper {
        display: none !important;
        visibility: hidden !important;
    }

    .mgs_join2_shell {
        position: relative;
        z-index: 2;
        padding: 28px 24px 48px;
        box-sizing: border-box;
    }
    .mgs_join2_shell::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg,
            rgba(255, 255, 255, 0.1) 0%,
            rgba(255, 255, 255, 0.04) 50%,
            rgba(15, 58, 106, 0.05) 100%);
        pointer-events: none;
        z-index: 0;
    }
    .mgs_join2_inner { position: relative; z-index: 1; max-width: 1040px; margin: 0 auto; }

    /* Hero above card */
    .mgs_join2_hero {
        text-align: center;
        margin-bottom: 28px;
        position: relative;
    }
    .mgs_join2_hero_badge {
        position: absolute;
        right: 0;
        top: 0;
        display: flex;
        align-items: center;
        gap: 8px;
        font-family: 'Source Sans 3', system-ui, sans-serif;
        font-size: 13px;
        font-weight: 600;
        color: var(--mgs-navy);
        max-width: 200px;
        text-align: right;
        line-height: 1.35;
    }
    .mgs_join2_hero_badge svg { flex-shrink: 0; color: var(--mgs-navy); }
    .mgs_join2_divider {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        max-width: 220px;
        margin: 0 auto 14px;
    }
    .mgs_join2_divider::before,
    .mgs_join2_divider::after {
        content: '';
        flex: 1;
        height: 2px;
        background: rgba(200, 154, 58, 0.75);
    }
    .mgs_join2_divider_heart { color: var(--mgs-gold); font-size: 16px; }
    .mgs_join2_hero h1 {
        font-family: 'Playfair Display', Georgia, serif;
        font-weight: 600;
        font-size: clamp(32px, 4.5vw, 44px);
        color: var(--mgs-navy);
        margin: 0 0 12px;
        line-height: 1.12;
    }
    .mgs_join2_hero_sub {
        font-family: 'Source Sans 3', system-ui, sans-serif;
        font-size: 16px;
        line-height: 1.55;
        color: var(--mgs-navy);
        max-width: 560px;
        margin: 0 auto;
        opacity: 0.92;
    }

    /* White card */
    .mgs_join2_card {
        background: #fff;
        border-radius: 22px;
        box-shadow: 0 24px 64px rgba(15, 58, 106, 0.2);
        padding: 36px 40px 40px;
        overflow: hidden;
    }
    html body .content.mgs_join2_content {
        background: transparent !important;
        min-height: 0 !important;
        padding: 0 !important;
    }
    html body .content .cont_vc {
        padding: 0 !important;
        max-width: none !important;
    }

    #full_step_1, #full_step_2 { display: none !important; }

    #full_step_3.bl_card_profile {
        display: block !important;
        background: transparent !important;
        padding: 0 !important;
        margin: 0 !important;
        box-shadow: none !important;
    }

    .card_profile {
        display: flex !important;
        flex-direction: row !important;
        align-items: flex-start !important;
        gap: 40px !important;
        width: 100% !important;
        max-width: none !important;
        margin: 0 !important;
        padding: 0 !important;
        background: transparent !important;
    }

    /* Left — photos */
    .card_profile .part_photo {
        flex: 0 0 280px;
        max-width: 280px;
        text-align: center;
        float: none !important;
        width: auto !important;
    }
    .mgs_photos_title {
        font-family: 'Playfair Display', Georgia, serif;
        font-weight: 600;
        font-size: 22px;
        color: var(--mgs-navy);
        margin: 0 0 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }
    .mgs_photos_spark { color: var(--mgs-gold); font-size: 18px; }

    .card_profile .part_photo .upload_file { margin: 0 auto 20px; }
    .card_profile .part_photo .upload {
        position: relative;
        width: 168px !important;
        height: 168px !important;
        margin: 0 auto !important;
        border-radius: 50% !important;
        background: var(--mgs-navy) !important;
        overflow: hidden;
        display: flex !important;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        border: 4px solid rgba(200, 154, 58, 0.35);
    }
    .card_profile .part_photo .upload img.pic {
        width: 100% !important;
        height: 100% !important;
        object-fit: cover;
        border-radius: 50%;
        display: block;
    }
    .card_profile .part_photo .upload:not(:has(img.pic[src*="blank"])) .mgs_photo_placeholder { display: none; }
    .mgs_photo_placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: rgba(255, 255, 255, 0.9);
        font-family: 'Source Sans 3', system-ui, sans-serif;
        font-size: 14px;
        font-weight: 600;
        text-align: center;
        padding: 20px;
        pointer-events: none;
    }
    .mgs_photo_placeholder svg { margin-bottom: 8px; opacity: 0.95; }
    .mgs_photo_cam {
        position: absolute;
        right: 8px;
        bottom: 8px;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #2dd4bf;
        border: 3px solid #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        pointer-events: none;
        z-index: 2;
    }
    .card_profile .part_photo .photo_add,
    .card_profile .part_photo .bl.photo_add {
        position: absolute !important;
        inset: 0 !important;
        width: 100% !important;
        height: 100% !important;
        opacity: 0 !important;
        cursor: pointer !important;
        z-index: 3;
        margin: 0 !important;
        font-size: 0 !important;
    }
    .card_profile .part_photo input.file {
        position: absolute !important;
        inset: 0 !important;
        width: 100% !important;
        height: 100% !important;
        opacity: 0 !important;
        cursor: pointer !important;
        z-index: 4;
    }

    .mgs_photo_tips {
        list-style: none;
        margin: 0 0 24px;
        padding: 0;
        text-align: left;
        font-family: 'Source Sans 3', system-ui, sans-serif;
        font-size: 13.5px;
        line-height: 1.5;
        color: var(--mgs-ink-soft);
    }
    .mgs_photo_tips li {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        margin-bottom: 12px;
    }
    .mgs_photo_tips li svg { flex-shrink: 0; margin-top: 2px; color: var(--mgs-navy); }
    .mgs_photo_tips strong { color: var(--mgs-ink); font-weight: 700; }

    .card_profile .part_photo .name {
        font-family: 'Playfair Display', Georgia, serif !important;
        font-size: 22px !important;
        font-weight: 600 !important;
        color: var(--mgs-navy) !important;
        margin: 0 0 4px !important;
    }
    .card_profile .part_photo .name_info {
        font-family: 'Source Sans 3', system-ui, sans-serif !important;
        font-size: 14px !important;
        color: var(--mgs-ink-soft) !important;
    }

    /* Right — form */
    .card_profile_info.card_join {
        flex: 1 1 auto;
        min-width: 0;
        float: none !important;
        width: auto !important;
        padding: 0 !important;
    }
    #frm_card_join .bl_basic {
        margin-bottom: 22px;
    }
    #frm_card_join .bl_basic .title {
        font-family: 'Playfair Display', Georgia, serif !important;
        font-size: 22px !important;
        font-weight: 600 !important;
        color: var(--mgs-navy) !important;
        margin-bottom: 6px !important;
        padding: 0 !important;
        background: none !important;
        border: none !important;
    }
    #frm_card_join .bl_basic:has(#about_me) .title { font-size: 0 !important; }
    #frm_card_join .bl_basic:has(#about_me) .title::after {
        content: "About Me";
        font-size: 22px;
        display: block;
    }
    #frm_card_join .bl_basic:has(#interested_in) .title { font-size: 0 !important; }
    #frm_card_join .bl_basic:has(#interested_in) .title::after {
        content: "What Are You Looking For in a Partner?";
        font-size: 20px;
        display: block;
        line-height: 1.25;
    }
    .mgs_field_hint {
        font-family: 'Source Sans 3', system-ui, sans-serif;
        font-size: 13.5px;
        color: var(--mgs-ink-soft);
        margin: 0 0 10px;
        line-height: 1.45;
    }
    #frm_card_join textarea.fl_basic {
        width: 100% !important;
        min-height: 120px !important;
        padding: 14px !important;
        border: 1px solid #d1d5db !important;
        border-radius: 8px !important;
        font-family: 'Source Sans 3', system-ui, sans-serif !important;
        font-size: 15px !important;
        line-height: 1.5 !important;
        resize: vertical;
        box-sizing: border-box;
    }
    #frm_card_join textarea#about_me::placeholder { color: #9ca3af; }
    #frm_card_join textarea#interested_in::placeholder {
        color: #9ca3af;
        font-size: 14px;
    }
    .mgs_char_count {
        text-align: right;
        font-size: 12px;
        color: #9ca3af;
        margin-top: 4px;
        font-family: 'Source Sans 3', system-ui, sans-serif;
    }

    /* Captcha */
    #frm_card_join > .bl:has(.capcha),
    #frm_card_join > .bl:has(.recaptcha_bl) {
        margin-top: 8px;
    }
    #frm_card_join .capcha_img {
        margin-bottom: 10px;
        cursor: pointer;
        border-radius: 8px;
        overflow: hidden;
        display: inline-block;
    }
    #frm_card_join .capcha_img img { display: block; max-height: 56px; }
    #frm_card_join .bl_inp_pos .inp.capcha {
        width: 100% !important;
        height: 44px !important;
        border: 1px solid #d1d5db !important;
        border-radius: 8px !important;
        padding: 0 14px !important;
        font-size: 15px !important;
    }
    .mgs_captcha_refresh {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 8px;
        font-family: 'Source Sans 3', system-ui, sans-serif;
        font-size: 13px;
        color: #2477ba;
        cursor: pointer;
        background: none;
        border: 0;
        padding: 0;
    }
    .mgs_captcha_refresh:hover { text-decoration: underline; }

    #join_done.btn_join_submit,
    #join_done {
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 8px !important;
        width: 100% !important;
        height: 52px !important;
        margin-top: 22px !important;
        background: var(--mgs-navy) !important;
        color: #fff !important;
        border: none !important;
        border-radius: 999px !important;
        font-family: 'Source Sans 3', system-ui, sans-serif !important;
        font-size: 14px !important;
        font-weight: 700 !important;
        letter-spacing: 1.2px !important;
        text-transform: uppercase !important;
        cursor: pointer !important;
        box-shadow: 0 6px 18px rgba(15, 58, 106, 0.28) !important;
    }
    #join_done:hover {
        background: #14487f !important;
        transform: translateY(-1px);
    }

    .mgs_join2_login_link {
        text-align: center;
        font-family: 'Source Sans 3', system-ui, sans-serif;
        font-size: 14px;
        color: var(--mgs-ink-soft);
        margin-top: 16px;
    }
    .mgs_join2_login_link a {
        color: #2477ba;
        font-weight: 600;
        text-decoration: none;
    }
    .mgs_join2_login_link a:hover { text-decoration: underline; }

    #step_loader { z-index: 99999; }

    @media (max-width: 900px) {
        .mgs_join2_hero_badge {
            position: static;
            justify-content: center;
            margin: 0 auto 16px;
            text-align: center;
        }
        .card_profile {
            flex-direction: column !important;
            align-items: center !important;
        }
        .card_profile .part_photo {
            flex: none;
            max-width: 100%;
            width: 100% !important;
        }
        .mgs_join2_card { padding: 28px 22px 32px; }
    }
</style>

<!-- Legacy Chameleon header (hidden; global MGS navbar from _header.html is used) -->
<div class="header mgs_join2_legacy_header">
    <div id="join_step" class="step">
        <ul><li class="selected"></li><li style="display:none;"></li><li style="display:none;"></li></ul>
        <script>setStepJoin();</script>
    </div>
    <div class="slogan"><span id="join_slogan"></span></div>
    <script>setSlogan();</script>
    <div class="logo">
        <a href="{url_main}{url_page_index}"><img src="{header_url_logo}" style="max-height:45px;max-width:238px;" alt="" /></a>
    </div>
</div>

<div class="mgs_join2_shell">
    <div class="mgs_join2_inner">

        <header class="mgs_join2_hero">
            <div class="mgs_join2_hero_badge">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M12 2 4 5v6c0 5 3.5 9.5 8 11 4.5-1.5 8-6 8-11V5l-8-3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                </svg>
                Your information is always confidential.
            </div>
            <div class="mgs_join2_divider" aria-hidden="true"><span class="mgs_join2_divider_heart">&#9825;</span></div>
            <h1>Complete Your Profile</h1>
            <p class="mgs_join2_hero_sub">Add a photo and tell us a little about yourself so other members can get to know you.</p>
        </header>

        <div class="mgs_join2_card">
            <div class="content mgs_join2_content">
                <div class="cont_vc">

<div id="full_step_1" class="bl_card_question" style="display:none;">
    <div class="card_question_cont"></div>
</div>
<div id="full_step_2" class="bl_card_question" style="display:none">
    <div class="bl_card_type"><div id="list_photos_card" class="list_photos_card"><div class="cl"></div></div></div>
</div>

<div id="full_step_3" class="bl_card_profile" <!-- begin_final_step_hide -->style="display:none"<!-- end_final_step_hide -->>
    <div class="card_profile">
        <div class="part_photo">
            <h2 class="mgs_photos_title"><span class="mgs_photos_spark" aria-hidden="true">&#10024;</span> Add Your Photos</h2>
            <div class="upload_file">
                <form id="photo_upload" data-id="" method="post" enctype="multipart/form-data" action="{url_page}">
                    <div class="upload">
                        <!-- begin_photo_upload_social -->
                        <style>
                            .card_profile .part_photo .upload img.pic { display: block; }
                            .card_profile .part_photo .upload_pic { display: none; }
                        </style>
                        <!-- end_photo_upload_social -->
                        <div class="mgs_photo_placeholder" id="mgs_photo_placeholder">
                            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.5"/>
                                <path d="M5 20c0-4 3.5-6 7-6s7 2 7 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                            </svg>
                            Add a Photo
                        </div>
                        <span class="mgs_photo_cam" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                                <path d="M4 7h3l2-2h6l2 2h3a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2z" stroke="currentColor" stroke-width="1.5"/>
                                <circle cx="12" cy="13" r="3.5" stroke="currentColor" stroke-width="1.5"/>
                            </svg>
                        </span>
                        <img id="photo_img" class="pic" src="{social_photo_uploaded_url}" alt="" />
                        <!-- begin_photo_upload -->
                        <div id="photo_loader" class="bl photo_loader to_hide">
                            <div class="css_loader photo_upload_loader">
                                <div class="spinner spinnerw center">
                                    <div class="spinner-blade"></div><div class="spinner-blade"></div>
                                    <div class="spinner-blade"></div><div class="spinner-blade"></div>
                                    <div class="spinner-blade"></div><div class="spinner-blade"></div>
                                    <div class="spinner-blade"></div><div class="spinner-blade"></div>
                                    <div class="spinner-blade"></div><div class="spinner-blade"></div>
                                    <div class="spinner-blade"></div><div class="spinner-blade"></div>
                                </div>
                            </div>
                        </div>
                        <div class="bl photo_add">{l_add_a_photo}</div>
                        <input id="photo_upload_file" name="photo_upload_file" class="file" accept="image/jpeg,image/png,image/gif" onChange="changeUploadPhoto($(this));" type="file"/>
                        <!-- end_photo_upload -->
                    </div>
                    <div class="upload_pic">
                        <input id="photo_upload_file_bind" name="photo_upload_file_bind" accept="image/jpeg,image/png,image/gif" class="file" onChange="changeUploadPhoto($(this));" type="file"/>
                    </div>
                    <input id="photo_upload_reset" style="display:none;" type="reset" value=""/>
                    <input id="photo_upload_submit" style="display:none;" type="submit"/>
                </form>
            </div>
            <div id="photo_upload_error" class="error" title=""></div>
            <ul class="mgs_photo_tips">
                <li>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 7h3l2-2h6l2 2h3a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2z" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="13" r="3.5" stroke="currentColor" stroke-width="1.5"/></svg>
                    <span>Use a <strong>real photo</strong> of yourself that is clear and current.</span>
                </li>
                <li>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M3 8l9 6 9-6" stroke="currentColor" stroke-width="1.5"/></svg>
                    <span>Add <strong>more than one</strong> photo so members can get to know the real you!</span>
                </li>
                <li>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 3 5 6v6c0 4.5 3 8.5 7 9.5 4-1 7-5 7-9.5V6l-7-3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
                    <span>Your information is always confidential.</span>
                </li>
            </ul>
            <div class="name">{user_name}</div>
            <div class="name_info">{user_age}, {user_city}</div>
        </div>

        <div id="frm_card_join" class="card_profile_info card_join">
            <!-- begin_basic -->
            <div class="bl bl_basic">
            <div class="title">{field}</div>
            <p class="mgs_field_hint mgs_hint-about">Share a little about who you are &mdash; your story, what you enjoy, the values that shape your everyday life, and what brings you joy. Members respond most to profiles that feel warm and genuine, so write in your own voice. There is no perfect length; a few honest sentences are enough.</p>
            <div id="{name}_error" class="error to_hide">{l_required_field}</div>
            <!-- begin_textarea -->
            <textarea id="{name}" class="placeholder_always fl_basic" name="{name}" placeholder="Write your bio here..." maxlength="{maxlen}"></textarea>
            <div class="mgs_char_count" data-for="{name}" aria-live="polite">0 / {maxlen}</div>
            <!-- end_textarea -->
            <!-- begin_text -->
            <input id="{name}" class="placeholder_always fl_basic basic_field" name="{name}" type="text" placeholder="{value}" maxlength="{maxlen}" value=""/>
            <!-- end_text -->
            </div>
            <!-- end_basic -->
            <!-- begin_default_captcha -->
            <div class="bl">
                <div title="{a_refresh}" class="capcha capcha_img" onclick="refreshCaptcha();">
                    <img id="img_join_captcha" src="{url_main}_server/securimage/securimage_show_custom.php?sid={sid}" alt="" />
                </div>
                <button type="button" class="mgs_captcha_refresh" onclick="refreshCaptcha(); return false;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 4v6h6M20 20v-6h-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M5.6 9A7 7 0 0 1 19 8l2-2M19 15a7 7 0 0 1-13.4 1l-2 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                    Refresh
                </button>
                <div class="bl_inp_pos">
                    <input id="captcha" name="captcha" class="inp capcha placeholder" type="text" placeholder="{a_enter_the_symbols_you_see}" value="" />
                    <div id="captcha_error" class="error to_hide">{l_incorrect_captcha}</div>
                </div>
                <div class="cl"></div>
            </div>
            <!-- end_default_captcha -->
            <!-- begin_re_captcha -->
            <div class="bl">
                <div class="recaptcha_bl">
                    <div id="recaptcha" class="recaptcha"></div>
                    <div id="captcha_error" class="error to_hide">{l_incorrect_captcha}</div>
                </div>
                <div class="cl"></div>
            </div>
            <!-- end_re_captcha -->
            <button id="join_done" class="btn turquoise small btn_join_submit" type="button">
                Create Account <span aria-hidden="true">&rsaquo;</span>
            </button>
            <p class="mgs_join2_login_link">Already have an account? <a href="/login">Log in</a></p>
        </div>
    </div>
</div>

<div id="step_loader" class="css_loader full_step_2_loader">
    <div class="spinner spinnerw center">
        <div class="spinner-blade"></div><div class="spinner-blade"></div>
        <div class="spinner-blade"></div><div class="spinner-blade"></div>
        <div class="spinner-blade"></div><div class="spinner-blade"></div>
        <div class="spinner-blade"></div><div class="spinner-blade"></div>
        <div class="spinner-blade"></div><div class="spinner-blade"></div>
        <div class="spinner-blade"></div><div class="spinner-blade"></div>
    </div>
</div>
<!-- begin_re_captcha_script -->
<script src="//www.google.com/recaptcha/api.js?onload=onloadCallback&render=explicit&hl={re_captcha_lang}" async defer></script>
<!-- end_re_captcha_script -->

                </div>
            </div>
        </div>
    </div>
</div>

<script>
(function($){
    function updateCharCount($ta) {
        var max = parseInt($ta.attr('maxlength'), 10) || 500;
        var len = ($ta.val() || '').length;
        var $c = $('.mgs_char_count[data-for="' + $ta.attr('name') + '"]');
        if ($c.length) $c.text(len + ' / ' + max);
    }
    function hidePlaceholderIfPhoto() {
        var $img = $('#photo_img');
        if (!$img.length) return;
        var src = $img.attr('src') || '';
        if (src && src.indexOf('blank') === -1 && src.indexOf('nophoto') === -1) {
            $('#mgs_photo_placeholder').hide();
        }
    }
    $(function(){
        $('textarea.fl_basic').each(function(){ updateCharCount($(this)); });
        $(document).on('input', 'textarea.fl_basic', function(){ updateCharCount($(this)); });
        hidePlaceholderIfPhoto();
        $(document).on('change', '#photo_upload_file, #photo_upload_file_bind', function(){
            setTimeout(hidePlaceholderIfPhoto, 500);
        });
        /* Only show "about" hint on about_me field */
        $('.bl_basic').each(function(){
            var $b = $(this);
            if ($b.find('#about_me').length) {
                $b.find('.mgs_hint-about').show();
            } else {
                $b.find('.mgs_hint-about').hide();
            }
            if ($b.find('#interested_in').length) {
                if (!$b.find('.mgs_hint-match').length) {
                    $b.find('.title').after('<p class="mgs_field_hint mgs_hint-match">Tell us what you are looking for in a person &mdash; the qualities that matter, your values, interests, and what makes a meaningful connection for you.</p>');
                }
            }
        });
        $('#full_step_3').show();
    });
})(jQuery);
</script>

{footer}
