{header}

<!-- Pre-launch gate flash toast (firstC.md Phase 2.3). Shown when a visitor
     was bounced here from a gated feature (search / events / upgrade / etc).
     Prelaunch::redirectToLanding appends ?__plfb=1; we detect that here,
     show a calm message, then strip the flag from the address bar so the
     URL doesn't carry the confusing token. Auto-dismisses after 6s. -->
<div class="mgs_flash_toast" id="mgs_flash_toast" aria-live="polite" aria-hidden="true">
    <span class="mgs_flash_toast_text">This feature opens at launch &mdash; we&rsquo;re nearly there.</span>
    <button class="mgs_flash_toast_close" type="button" aria-label="Dismiss">&times;</button>
</div>
<style>
    .mgs_flash_toast {
        position: fixed; top: 18px; left: 50%; transform: translate(-50%, -16px);
        z-index: 9999; max-width: 92vw;
        background: #f7f3ec; color: #1f2937;
        border: 1.5px solid #c89a3a; border-radius: 999px;
        box-shadow: 0 8px 24px rgba(15, 58, 106, 0.18);
        padding: 11px 22px 11px 22px;
        font-family: 'Lato', 'Inter', system-ui, sans-serif;
        font-size: 14.5px; letter-spacing: 0.1px;
        display: none; align-items: center; gap: 14px;
        opacity: 0; transition: opacity 0.32s ease, transform 0.32s ease;
    }
    .mgs_flash_toast.is-visible { display: inline-flex; opacity: 1; transform: translate(-50%, 0); }
    .mgs_flash_toast_text { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .mgs_flash_toast_close {
        background: transparent; border: 0; color: #5b6471;
        font-size: 20px; line-height: 1; cursor: pointer; padding: 0 2px;
    }
    .mgs_flash_toast_close:hover { color: #1f2937; }
    @media (max-width: 480px) {
        .mgs_flash_toast { font-size: 13.5px; padding: 10px 16px; }
        .mgs_flash_toast_text { white-space: normal; }
    }
</style>
<script>
(function () {
    var qs = new URLSearchParams(window.location.search || '');
    if (qs.get('__plfb') !== '1') return;
    var toast = document.getElementById('mgs_flash_toast');
    if (!toast) return;
    toast.classList.add('is-visible');
    toast.setAttribute('aria-hidden', 'false');
    // Strip the flag from the address bar so reload / share doesn't carry it.
    qs.delete('__plfb');
    var cleanQuery = qs.toString();
    var cleanUrl = window.location.pathname + (cleanQuery ? '?' + cleanQuery : '') + window.location.hash;
    try { history.replaceState(null, '', cleanUrl); } catch (e) { /* old browser, skip */ }
    var dismiss = function () {
        toast.classList.remove('is-visible');
        setTimeout(function () { toast.setAttribute('aria-hidden', 'true'); }, 320);
    };
    var btn = toast.querySelector('.mgs_flash_toast_close');
    if (btn) btn.addEventListener('click', dismiss);
    setTimeout(dismiss, 6000);
})();
</script>

<!-- Pre-launch announcement strip (only renders when platform_mode = prelaunch).
     Moved from a centred popup that used to cover the hero, to a slim top
     strip so the hero photo stays clear. -->
<!-- begin_prelaunch_banner -->
<div class="mgs_prelaunch_strip">
    <div class="mgs_prelaunch_strip_inner">
        <span class="mgs_prelaunch_spark" aria-hidden="true">&#10024;</span>
        Registration is now open &mdash; create your <strong class="mgs_prelaunch_free">FREE</strong> account and be among the first to join Meet Greek Singles.
    </div>
</div>
<!-- end_prelaunch_banner -->

<!-- HERO ──────────────────────────────────────────────────────────────────── -->
<!-- v12 single integrated cinematic per Irene's reference: full-width video,
     soft diagonal navy gradient on the upper-left bleeds gently into the
     bright photo. No structural split, no hard panel edge. Image stays
     vivid all the way across. -->
<section class="mgs_hero">
    <!-- preload=auto so the 4 MB hero video starts downloading immediately on
         page load, eliminating the buffering window where the poster used to
         flash. No poster attribute — the .mgs_hero CSS fallback below paints
         a sea-blue gradient that blends into the video frame as it appears. -->
    <video class="mgs_hero_video" autoplay muted loop playsinline preload="auto">
        <source src="/_files/hero_couple_v2.mp4" type="video/mp4">
    </video>

    <!-- Soft diagonal navy gradient + warm peach bloom for dating warmth.
         Heavy at top-left, fades to fully clear by 75% of width. -->
    <div class="mgs_hero_overlay" aria-hidden="true"></div>

    <div class="mgs_hero_inner">
        <h1 class="mgs_hero_title">Create Your<br>Free Account</h1>
        <p class="mgs_hero_emotional">Start your journey to a meaningful Greek connection</p>
        <div class="mgs_hero_divider" aria-hidden="true"><span class="mgs_hero_divider_heart">&#9825;</span></div>
        <p class="mgs_hero_subtext">
            Join a warm, authentic community built on shared roots,
            values, and real connection.
        </p>
        <a class="mgs_hero_cta" href="/join">Create Account &rsaquo;</a>
        <div class="mgs_hero_trust">
            <svg class="mgs_hero_trust_icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 2 4 5v6c0 5 3.5 9.5 8 11 4.5-1.5 8-6 8-11V5l-8-3z"
                      stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" fill="rgba(255,255,255,0.06)"/>
                <path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.7"
                      stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="mgs_hero_trust_line">Your information is always private and secure.</span>
        </div>
    </div>

    <!-- Wavy bottom edge — fills navy + thin gold accent. -->
    <svg class="mgs_hero_wave" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0,30 C240,90 480,0 720,40 C960,80 1200,20 1440,55 L1440,90 L0,90 Z"
              fill="#0f3a6a"/>
        <path d="M0,30 C240,90 480,0 720,40 C960,80 1200,20 1440,55"
              stroke="rgba(196, 152, 70, 0.85)" stroke-width="3" fill="none"
              vector-effect="non-scaling-stroke"/>
    </svg>
</section>

<!-- BOTTOM (NAVY) SECTION ──────────────────────────────────────────────────── -->
<section class="mgs_features">
    <p class="mgs_section_eyebrow">Our Promise</p>
    <h2 class="mgs_section_heading">Find Your Greek Connection</h2>

    <p class="mgs_identity">
        Identity is personal. Whether you have one Greek parent or are from
        the diaspora, you are welcome here.
    </p>

    <div class="mgs_features_heart" aria-hidden="true">&#9825;</div>

    <div class="mgs_features_grid">
        <div class="mgs_feature">
            <span class="mgs_feature_num">01</span>
            <div class="mgs_feature_icon">
                <svg width="44" height="44" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M12 21s-7.5-4.5-7.5-10A4.5 4.5 0 0 1 12 7a4.5 4.5 0 0 1 7.5 4c0 5.5-7.5 10-7.5 10z"
                          stroke="currentColor" stroke-width="2" stroke-linejoin="round" fill="none"/>
                </svg>
            </div>
            <h3>Meaningful Connections</h3>
            <p>We bring together Greek singles who are looking for authentic, long-term relationships.</p>
        </div>

        <div class="mgs_feature">
            <span class="mgs_feature_num">02</span>
            <div class="mgs_feature_icon">
                <svg width="44" height="44" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M5 4h14v3H5zM5 20h14v-3H5zM7 7h2v10H7zM15 7h2v10h-2z"
                          stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" fill="none"/>
                    <path d="M9 11h6M9 13h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
            </div>
            <h3>Built on Shared Values</h3>
            <p>Faith, family, culture and tradition are at the heart of our community.</p>
        </div>

        <div class="mgs_feature">
            <span class="mgs_feature_num">03</span>
            <div class="mgs_feature_icon">
                <svg width="44" height="44" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M12 3 5 6v6c0 4.5 3 8.5 7 9.5 4-1 7-5 7-9.5V6l-7-3z"
                          stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" fill="none"/>
                    <rect x="9.5" y="11" width="5" height="4" rx="0.5"
                          stroke="currentColor" stroke-width="1.6" fill="none"/>
                    <path d="M10.5 11v-1.5a1.5 1.5 0 0 1 3 0V11"
                          stroke="currentColor" stroke-width="1.6" fill="none"/>
                </svg>
            </div>
            <h3>Safe &amp; Private</h3>
            <p>Your privacy and security are our top priority.</p>
        </div>

        <div class="mgs_feature">
            <span class="mgs_feature_num">04</span>
            <div class="mgs_feature_icon">
                <svg width="44" height="44" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.9" fill="none"/>
                    <ellipse cx="12" cy="12" rx="4" ry="9" stroke="currentColor" stroke-width="1.9" fill="none"/>
                    <path d="M3 12h18" stroke="currentColor" stroke-width="1.9"/>
                </svg>
            </div>
            <h3>Worldwide Community</h3>
            <p>Connect with Greek singles across Greece and around the world.</p>
        </div>
    </div>

    <p class="mgs_closing">
        <svg class="mgs_closing_laurel mgs_closing_laurel_l" width="84" height="34" viewBox="0 0 84 34" fill="none" aria-hidden="true">
            <path d="M80 17 C60 24 30 24 4 19" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" fill="none"/>
            <!-- Upper leaves -->
            <ellipse cx="68" cy="10" rx="4.2" ry="1.7" fill="currentColor" transform="rotate(38 68 10)"/>
            <ellipse cx="56" cy="8"  rx="4.4" ry="1.7" fill="currentColor" transform="rotate(33 56 8)"/>
            <ellipse cx="44" cy="8"  rx="4.4" ry="1.7" fill="currentColor" transform="rotate(28 44 8)"/>
            <ellipse cx="32" cy="9"  rx="4.2" ry="1.6" fill="currentColor" transform="rotate(22 32 9)"/>
            <ellipse cx="20" cy="12" rx="3.8" ry="1.5" fill="currentColor" transform="rotate(15 20 12)"/>
            <!-- Lower leaves -->
            <ellipse cx="62" cy="24" rx="4"   ry="1.6" fill="currentColor" transform="rotate(-32 62 24)"/>
            <ellipse cx="50" cy="25" rx="4.2" ry="1.6" fill="currentColor" transform="rotate(-27 50 25)"/>
            <ellipse cx="38" cy="25" rx="4.2" ry="1.6" fill="currentColor" transform="rotate(-22 38 25)"/>
            <ellipse cx="26" cy="24" rx="3.8" ry="1.5" fill="currentColor" transform="rotate(-16 26 24)"/>
        </svg>
        Because the right connection can change everything.
        <svg class="mgs_closing_laurel mgs_closing_laurel_r" width="84" height="34" viewBox="0 0 84 34" fill="none" aria-hidden="true">
            <path d="M4 17 C24 24 54 24 80 19" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" fill="none"/>
            <!-- Upper leaves -->
            <ellipse cx="16" cy="10" rx="4.2" ry="1.7" fill="currentColor" transform="rotate(-38 16 10)"/>
            <ellipse cx="28" cy="8"  rx="4.4" ry="1.7" fill="currentColor" transform="rotate(-33 28 8)"/>
            <ellipse cx="40" cy="8"  rx="4.4" ry="1.7" fill="currentColor" transform="rotate(-28 40 8)"/>
            <ellipse cx="52" cy="9"  rx="4.2" ry="1.6" fill="currentColor" transform="rotate(-22 52 9)"/>
            <ellipse cx="64" cy="12" rx="3.8" ry="1.5" fill="currentColor" transform="rotate(-15 64 12)"/>
            <!-- Lower leaves -->
            <ellipse cx="22" cy="24" rx="4"   ry="1.6" fill="currentColor" transform="rotate(32 22 24)"/>
            <ellipse cx="34" cy="25" rx="4.2" ry="1.6" fill="currentColor" transform="rotate(27 34 25)"/>
            <ellipse cx="46" cy="25" rx="4.2" ry="1.6" fill="currentColor" transform="rotate(22 46 25)"/>
            <ellipse cx="58" cy="24" rx="3.8" ry="1.5" fill="currentColor" transform="rotate(16 58 24)"/>
        </svg>
    </p>

    <div class="mgs_closing_heart" aria-hidden="true">&#9825;</div>

</section>

<style>
    /* ─────────────────────────────────────────────────────────────────────
       Homepage redesign 2026-04-27 — matches Irene's mockup.
       Palette:  ivory cream + soft blue + restrained gold.
       Typography: Playfair Display (headings), Source Sans 3 (body).
       ───────────────────────────────────────────────────────────────────── */

    :root {
        --mgs-cream:     #f7f3ec;
        --mgs-cream-2:   #fdf8e8;
        --mgs-ivory:     #ffffff;
        --mgs-ink:       #1f2937;
        --mgs-ink-soft:  #5b6471;
        --mgs-blue:      #14487f;
        --mgs-blue-deep: #0f3a6a;
        --mgs-gold:      #b88a3e;
        --mgs-gold-soft: #e6c97a;
        --mgs-line:      #e8e1d2;
    }

    /* Hide the old pre-launch popup if it slips through; we now emit our
       own thin top strip from the begin_prelaunch_banner block. */
    body > .prelaunch_banner,
    .wrap_header_cont .prelaunch_banner { display: none !important; }

    /* ─── PRE-LAUNCH STRIP (top of page) ────────────────────────────────
       Tuned to match mockup: subtle warm cream, gold sparkle, FREE in gold,
       slim gold hairline border so it reads as elegant rather than loud. */
    .mgs_prelaunch_strip {
        background: #fbf3df;
        border-bottom: 1px solid rgba(184, 138, 62, 0.42);
        padding: 14px 20px;
        text-align: center;
        font-family: 'Source Sans 3', system-ui, sans-serif;
        color: #3a2a0e;
        font-size: 15px;
        font-weight: 500;
        line-height: 1.45;
        letter-spacing: 0.2px;
        position: relative;
        z-index: 50;
    }
    .mgs_prelaunch_strip_inner { max-width: 1040px; margin: 0 auto; }
    .mgs_prelaunch_spark {
        color: #a17422;
        margin-right: 8px;
        font-size: 16px;
    }
    .mgs_prelaunch_free {
        color: #a17422;
        font-weight: 800;
        letter-spacing: 0.6px;
    }

    /* ─── HERO (single integrated image with soft diagonal overlay) ───── */
    .mgs_hero {
        position: relative;
        min-height: 96vh;
        max-height: 1020px;
        display: flex;
        align-items: flex-start;
        justify-content: flex-start;
        overflow: hidden;
        background: #1c2742;
    }
    /* Soft layered overlay: warm peach bloom at the upper-left (dating
       warmth) + diagonal navy gradient that's heavy on the left and fades
       fully clear by ~75% so the image stays vivid on the right. No blur,
       no hard rectangular block — feels like one cinematic scene. */
    .mgs_hero_overlay {
        position: absolute;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        background:
            radial-gradient(ellipse 40% 50% at 10% 22%,
                rgba(255, 198, 158, 0.04) 0%,
                rgba(255, 198, 158, 0)    60%),
            linear-gradient(102deg,
                rgba(20, 33, 58, 0.50) 0%,
                rgba(20, 33, 58, 0.34) 14%,
                rgba(20, 33, 58, 0.18) 26%,
                rgba(20, 33, 58, 0.06) 38%,
                rgba(20, 33, 58, 0)    46%);
    }
    /* Soft cream-to-transparent fade at the TOP so the cream navbar above
       blends down into the photo without a hard horizontal line. */
    .mgs_hero::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 90px;
        z-index: 3;
        background: linear-gradient(to bottom,
            rgba(247,243,236,0.55) 0%,
            rgba(247,243,236,0.25) 50%,
            rgba(247,243,236,0)    100%);
        pointer-events: none;
    }
    .mgs_hero_inner {
        position: relative;
        z-index: 2;
        padding: 100px 40px 100px 72px;
        width: 34%;
        max-width: 470px;
        min-width: 300px;
        color: #fff;
        text-align: center;
    }
    /* Stronger cinematic text shadow so the headline and subtext read
       cleanly against the much-lightened overlay. */
    .mgs_hero_inner .mgs_hero_title,
    .mgs_hero_inner .mgs_hero_subtext,
    .mgs_hero_inner .mgs_hero_cta,
    .mgs_hero_inner .mgs_hero_trust_line,
    .mgs_hero_inner .mgs_hero_emotional {
        text-shadow: 0 3px 26px rgba(0, 0, 0, 0.78);
    }

    /* Wave at the bottom of the hero — fills navy + gold accent. */
    .mgs_hero_wave {
        position: absolute;
        bottom: -1px;
        left: 0;
        width: 100%;
        height: 90px;
        z-index: 5;
        display: block;
        pointer-events: none;
    }
    .mgs_hero_title {
        font-family: 'Playfair Display', Georgia, serif;
        font-weight: 600;
        font-size: 47px;
        line-height: 1.1;
        letter-spacing: -0.4px;
        margin: 0 0 6px;
        color: #f3e3b8;
        text-shadow: 0 4px 28px rgba(0,0,0,0.6);
    }
    .mgs_hero_emotional {
        font-family: 'Playfair Display', Georgia, serif;
        font-style: italic;
        font-weight: 400;
        font-size: 20px;
        line-height: 1.4;
        color: #c89a3a;
        margin: 10px 0 0;
        letter-spacing: 0.3px;
    }
    .mgs_hero_divider {
        display: flex;
        align-items: center;
        gap: 14px;
        max-width: 220px;
        margin: 28px auto 0;
    }
    .mgs_hero_divider::before,
    .mgs_hero_divider::after {
        content: '';
        flex: 1;
        height: 2px;
        background: rgba(216, 179, 90, 0.78);
    }
    .mgs_hero_divider_heart {
        color: var(--mgs-gold-soft);
        font-size: 18px;
        line-height: 1;
        opacity: 0.92;
    }
    .mgs_hero_subtext {
        font-family: 'Source Sans 3', system-ui, sans-serif;
        font-size: 16px;
        line-height: 1.75;
        font-weight: 300;
        margin: 22px auto 0;
        max-width: 380px;
        color: rgba(252, 245, 230, 0.92);
        text-shadow: 0 1px 6px rgba(0,0,0,0.4);
    }
    .mgs_hero_cta {
        display: inline-block;
        margin-top: 26px;
        padding: 15px 38px;
        background: var(--mgs-blue-deep);
        color: #fff;
        font-family: 'Source Sans 3', system-ui, sans-serif;
        font-weight: 600;
        font-size: 15px;
        letter-spacing: 0.9px;
        text-transform: uppercase;
        border: 2px solid var(--mgs-gold);
        border-radius: 999px;
        text-decoration: none;
        white-space: nowrap;
        box-shadow: 0 6px 18px rgba(15, 58, 106, 0.32);
        transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
    }
    .mgs_hero_cta:hover {
        background: var(--mgs-gold);
        color: #fff;
        border-color: var(--mgs-gold);
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(184, 138, 62, 0.34);
        text-decoration: none;
    }
    .mgs_hero_trust {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-top: 30px;
        max-width: 100%;
    }
    .mgs_hero_trust_icon {
        flex-shrink: 0;
        color: var(--mgs-gold-soft);
        opacity: 0.95;
    }
    .mgs_hero_trust_line {
        color: rgba(255, 255, 255, 0.88);
        font-family: 'Source Sans 3', system-ui, sans-serif;
        font-size: 13.5px;
        letter-spacing: 0.2px;
        text-shadow: 0 1px 4px rgba(0,0,0,0.3);
    }

    /* ─── CREAM SECTION (identity + 4 features + closing) ──────────────── */
    .mgs_features {
        background: var(--mgs-blue-deep);
        padding: 92px 24px 104px;
        text-align: center;
        font-family: 'Source Sans 3', system-ui, sans-serif;
        color: #ffffff;
        position: relative;
    }
    .mgs_section_eyebrow {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        font-family: 'Source Sans 3', system-ui, sans-serif;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 2.6px;
        text-transform: uppercase;
        color: var(--mgs-gold-soft);
        margin: 0 0 22px;
        opacity: 0.9;
    }
    .mgs_section_eyebrow::before,
    .mgs_section_eyebrow::after {
        content: '';
        width: 36px;
        height: 1px;
        background: rgba(218, 178, 102, 0.55);
    }
    .mgs_section_heading {
        font-family: 'Playfair Display', Georgia, serif;
        font-weight: 600;
        font-size: clamp(32px, 4.2vw, 46px);
        line-height: 1.16;
        color: #ffffff;
        margin: 0 auto 40px;
        max-width: 800px;
        letter-spacing: -0.3px;
    }
    .mgs_identity {
        font-family: 'Source Sans 3', system-ui, sans-serif;
        font-size: clamp(17px, 2.2vw, 20px);
        line-height: 1.7;
        max-width: 720px;
        margin: 0 auto 36px;
        color: rgba(255, 255, 255, 0.88);
        font-weight: 400;
    }
    .mgs_features_heart {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        color: var(--mgs-gold-soft);
        font-size: 22px;
        margin: 0 auto 56px;
        opacity: 0.9;
        line-height: 1;
    }
    .mgs_features_heart::before,
    .mgs_features_heart::after {
        content: '';
        width: 36px;
        height: 1px;
        background: rgba(218, 178, 102, 0.55);
    }

    .mgs_features_grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 30px;
        max-width: 1200px;
        margin: 0 auto 90px;
    }
    .mgs_feature {
        text-align: center;
        padding: 50px 28px 46px;
        background: #fffaee;
        border: 1.5px solid rgba(184, 138, 62, 0.55);
        border-radius: 6px;
        box-shadow: 0 3px 14px rgba(0, 0, 0, 0.12);
        transition: transform 0.3s, box-shadow 0.3s, border-color 0.3s;
    }
    .mgs_feature:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 26px rgba(0, 0, 0, 0.22);
        border-color: rgba(184, 138, 62, 0.85);
    }
    .mgs_feature_num {
        display: block;
        font-family: 'Playfair Display', Georgia, serif;
        font-style: italic;
        font-size: 17px;
        color: #a17422;
        letter-spacing: 1.2px;
        margin-bottom: 20px;
        opacity: 1;
    }
    .mgs_feature_icon {
        width: 86px;
        height: 86px;
        margin: 0 auto 30px;
        border-radius: 50%;
        background: var(--mgs-cream-2);
        border: 1.5px solid rgba(184,138,62,0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #a17422;
    }
    .mgs_feature h3 {
        font-family: 'Playfair Display', Georgia, serif;
        font-weight: 500;
        font-size: 21px;
        line-height: 1.25;
        color: var(--mgs-ink);
        margin: 0 0 20px;
        padding-bottom: 18px;
        letter-spacing: 0.2px;
        position: relative;
    }
    .mgs_feature h3::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 36px;
        height: 1.5px;
        background: var(--mgs-gold);
        opacity: 0.65;
    }
    .mgs_feature p {
        font-size: 15px;
        line-height: 1.75;
        color: var(--mgs-ink-soft);
        margin: 0 auto;
        max-width: 240px;
    }
    .mgs_closing {
        font-family: 'Playfair Display', Georgia, serif;
        font-style: italic;
        font-size: clamp(18px, 2.2vw, 21px);
        color: rgba(230, 201, 122, 0.88);
        margin: 0;
        letter-spacing: 0.6px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 18px;
        flex-wrap: wrap;
    }
    .mgs_closing_laurel {
        color: #d6a83f;
        opacity: 0.85;
        flex-shrink: 0;
    }
    .mgs_closing_heart {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        color: var(--mgs-gold-soft);
        font-size: 16px;
        line-height: 1;
        margin: 26px auto 0;
        opacity: 0.85;
    }
    .mgs_closing_heart::before,
    .mgs_closing_heart::after {
        content: '';
        width: 28px;
        height: 1px;
        background: rgba(218, 178, 102, 0.5);
    }

    /* ─── HIDE LEGACY HOMEPAGE ELEMENTS WE'RE REPLACING ────────────────── */
    body .bl_main_info { display: none !important; }
    body .bl_join_done { display: none !important; }
    body .footer { background: transparent !important; }

    /* ─── FOOTER READABILITY (per Irene 2026-04-28) ──────────────────────
       Global footer is #688bc6 12px which is unreadable on the cream
       background. Override locally on the homepage. */
    body .footer { color: var(--mgs-ink) !important; font-size: 14px !important; font-weight: 500 !important; }
    body .footer .nav li a { color: #0f1419 !important; font-weight: 600 !important; }
    body .footer .nav li a:hover { color: var(--mgs-gold) !important; }
    body .footer .nav li span { color: #6b7380 !important; }
    body .footer_w .title_orig { font-size: 13px !important; color: var(--mgs-ink) !important; font-weight: 600 !important; }

    /* ─── HOMEPAGE-SPECIFIC OVERRIDES ───────────────────────────────────── */

    /* The wrapping containers Chameleon wraps page content in were defaulting
       to position: absolute on desktop, which pulled the new sections out of
       normal flow and made the 4-column features overlap / sit behind the
       legacy .header video. Force them back to normal block flow. */
    body .wrap_header_cont,
    body .wrap_header_cont.absolute,
    html body .wrap_header_cont,
    html body .wrap_header_cont.absolute {
        position: relative !important;
        top: auto !important; left: auto !important; right: auto !important;
        height: auto !important;
        min-height: 0 !important;
        width: 100% !important;
        max-width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
    }
    body .wrap_header_cont > .bl {
        width: 100% !important;
        max-width: 100% !important;
        padding: 0 !important;
        margin: 0 !important;
    }

    /* Legacy .header is the bg-video container Chameleon emits AFTER the
       page content — collapse it on the homepage since our new hero has
       its own video inline. */
    body .header,
    body .main.above .wrapper {
        min-height: 0 !important;
        height: auto !important;
        background: transparent !important;
    }
    body .header > .video-wrapper,
    body .video-wrapper {
        display: none !important;
    }
    /* Same for the legacy .content wrapper that held bl_main_info */
    body .content {
        background: transparent !important;
        min-height: 0 !important;
        padding: 0 !important;
    }

    /* Video fills the entire hero behind the overlay. The fallback for the
       sub-second window before the video paints (and for slow networks /
       codec issues) is a sea-blue gradient that mirrors the actual video's
       dominant tone — Aegean sky on top, deeper sea below — so when the
       video does kick in, the transition is invisible. Replaces the
       2026-04-29 chairs photo fallback (Irene 2026-05-03 — that bg flashed
       distractingly before the video loaded). */
    .mgs_hero {
        background:
            linear-gradient(180deg,
                #2a6c9a 0%,
                #5fa7c9 38%,
                #4a8eb2 72%,
                #1f3f63 100%);
        background-size: cover;
        background-position: center center;
    }
    /* Source video is pre-cropped (Shutterstock 4K → 1920x1080) so the couple
       sits naturally on the right ~60% of the frame. No CSS transform needed. */
    .mgs_hero_video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center center;
        z-index: 0;
        pointer-events: none;
    }

    /* ─── RESPONSIVE ────────────────────────────────────────────────────── */
    html, body { overflow-x: hidden; max-width: 100%; }

    @media (max-width: 880px) {
        .mgs_features_grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 28px 20px;
        }
    }

    @media (max-width: 880px) {
        .mgs_hero {
            min-height: 540px;
            max-height: none;
        }
        .mgs_hero_overlay {
            background: linear-gradient(180deg,
                rgba(20, 33, 58, 0.55) 0%,
                rgba(20, 33, 58, 0.85) 60%,
                rgba(20, 33, 58, 0.92) 100%);
        }
        .mgs_hero_inner {
            width: 100%;
            max-width: 600px;
            padding: 80px 24px 110px;
        }
    }

    @media (max-width: 768px) {
        .mgs_hero { min-height: 480px; }
        .mgs_hero_inner { width: 100%; max-width: 100%; padding: 70px 22px 100px; }
        .mgs_hero_title { font-size: 31px; line-height: 1.14; letter-spacing: -0.3px; margin-bottom: 4px; }
        .mgs_hero_emotional { font-size: 17px; }
        .mgs_hero_subtext { font-size: 15px; max-width: 100%; margin-top: 18px; line-height: 1.7; }
        .mgs_hero_cta { padding: 13px 30px; font-size: 13px; margin-top: 22px; }
        .mgs_hero_trust { margin-top: 24px; }
        .mgs_hero_trust_line { font-size: 12.5px; }
        .mgs_hero_divider { max-width: 180px; margin-top: 14px; }

        .mgs_features { padding: 80px 16px 88px; }
        .mgs_section_eyebrow { font-size: 11px; letter-spacing: 2.4px; }
        .mgs_section_heading { font-size: 30px; margin-bottom: 24px; }
        .mgs_identity { margin-bottom: 24px; font-size: 17px; }
        .mgs_features_heart { font-size: 20px; margin-bottom: 32px; }
        .mgs_features_grid { gap: 18px; margin-bottom: 56px; }
        .mgs_feature { padding: 32px 22px 30px; }
        .mgs_feature_num { font-size: 14px; margin-bottom: 12px; }
        .mgs_feature h3 { font-size: 18px; padding-bottom: 14px; margin-bottom: 14px; }
        .mgs_feature p { font-size: 14.5px; }
        .mgs_feature_icon { width: 76px; height: 76px; }
        .mgs_closing { font-size: 17px; gap: 14px; }
        .mgs_closing_laurel { width: 56px; height: 22px; }
        .mgs_closing_heart { font-size: 14px; margin-top: 22px; }

        .mgs_prelaunch_strip { font-size: 14px; padding: 12px 14px; }
    }

    @media (max-width: 480px) {
        .mgs_features_grid {
            grid-template-columns: 1fr;
            gap: 30px;
        }
        .mgs_hero_title { font-size: 30px; }
    }
</style>
{footer}
