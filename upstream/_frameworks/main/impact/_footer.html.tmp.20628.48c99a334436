	<!-- footer -->
    <!-- 2026-05-28 — visitor footer. firstC.md §9.3 locks the link order
         (About → Terms & Conditions → Privacy Policy → Questions & Answers
         → Contact), so we hardcode the 5 items here instead of relying on
         the encoded vendor's {bottom_visitor_menu_item} loop (which only
         renders pages whose menu_title matches a hardcoded keylist inside
         Chameleon core, dropping some of our spec items). Links use
         Chameleon's standard URL patterns so admin can still edit the
         pages bodies. -->
    <div class="footer mgs_footer">
        <div class="mgs_footer_inner">
            <div class="mgs_footer_brand">
                <span class="mgs_footer_brand_name"><span class="mgs_footer_heart">&#9825;</span>Meet Greek Singles</span>
                <p class="mgs_footer_tagline">Serious connections for the Greek diaspora &mdash; rooted in shared heritage, culture, and values.</p>
            </div>
            <ul class="mgs_footer_links">
                <li><a href="{url_main}about">About</a></li>
                <li><a href="{url_main}info.php?page=term_cond">Terms &amp; Conditions</a></li>
                <li><a href="{url_main}info.php?page=priv_policy">Privacy Policy</a></li>
                <li><a href="{url_main}help">Questions &amp; Answers</a></li>
                <li><a href="{url_main}contact">Contact</a></li>
            </ul>
        </div>
        <div class="mgs_footer_bottom">
            <span class="mgs_footer_copy">&copy; {year} Meet Greek Singles. All rights reserved.</span>
            <span class="mgs_footer_close">Made with care for the Greek world.</span>
        </div>
        <div class="footer_w" style="display:none;">
            <!-- begin_bottom_visitor_menu -->
            <ul class="nav">
                <!-- begin_bottom_visitor_menu_item -->
                <li>
                    <!-- begin_bottom_visitor_menu_item_stick -->
