<style>
    .goog-te-combo {
    padding: 8px 12px;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    background-color: #ffffff;
    font-size: 14px;
    color: #333;
    outline: none;
    transition: all 0.3s ease;
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
}
#google_translate_element {
    display: inline-block;
    padding: 5px;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}
div#google_translate_element {
    position: fixed;
    top: 0;
}
.goog-te-combo:hover {
    border-color: #4285f4; /* Google Blue */
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.goog-te-combo:focus {
    border-color: #4285f4;
    box-shadow: 0 0 0 2px rgba(66, 133, 244, 0.2);
}

/* 4. Hide the "Powered by" branding (Optional/Clean look) */
.goog-te-gadget {
    color: transparent !important; /* Hides the text "Powered by" */
    font-size: 0 !important;
}

.goog-te-gadget img {
    display: none !important; /* Hides the Google Logo if desired */
}

.goog-te-gadget .VIpgJd-ZVi9od-l4eHX-hSRGPd {
    display: none !important; /* Hides the link wrapper */
}

 

.goog-te-banner-frame.skiptranslate {
    display: none !important;
}

/* 6. Tooltip/Hover Styling */
.goog-tooltip {
    display: none !important;
}
.goog-tooltip:hover {
    display: none !important;
}
.goog-text-highlight {
    background-color: transparent !important;
    border: none !important; 
    box-shadow: none !important;
}
@media only screen and (max-width:1200px)
{
    .bl_join_done {
        top: 130px;
    }
}

</style>

<!-- ────────────────────────────────────────────────────────────────────────
     SITE-WIDE MOBILE-SAFETY LAYER (2026-04-25)
     Loaded at the END of the body so it wins the cascade against the inline
     <style> blocks in register.html / login.html / index.html / etc. The
     impact theme's stock CSS hardcodes desktop widths everywhere; these
     rules clamp every common container to the viewport on phones + tablets
     so no page ever requires horizontal scrolling.
     ──────────────────────────────────────────────────────────────────────── -->
<style id="impact-mobile-safety-final">
    /* Hard nuke — kill horizontal scroll on every device. */
    html, body {
        max-width: 100vw !important;
        overflow-x: hidden !important;
    }

    @media (max-width: 900px) {
        /* ─── ROOT CONTAINERS ─── force every well-known wrapper to fit. */
        body, .main, .wrapper, .header, .content, .cont_w,
        .col_center, .col.center, .frame_content, .cs-container,
        .col_main, .column_main, .col.left, .col.right,
        .col, .bl, .cont, .frame,
        #colfix_l, #colfix_l_bl, #colfix_r, #colfix_r_bl,
        .container, .page, .page_wrap {
            max-width: 100% !important;
            min-width: 0 !important;
            width: auto !important;
            margin-left: auto !important;
            margin-right: auto !important;
            box-sizing: border-box !important;
        }

        /* ─── HEADER (logo + sign-in/sign-up buttons) ─── stack + centre. */
        .head_top, .head_top.absolute,
        .head_top_bl, .head_logo_inner, .head_top_inner {
            position: relative !important;
            left: 0 !important; right: 0 !important; top: 0 !important;
            transform: none !important;
            width: 100% !important;
            max-width: 100% !important;
            padding: 12px 16px !important;
            text-align: center !important;
            box-sizing: border-box !important;
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
            gap: 10px !important;
        }
        .head_top .blsss_logo,
        .head_top .bl_logo {
            display: block !important;
            margin: 0 auto !important;
            float: none !important;
        }
        .head_top #logo_main_page,
        .head_top .blsss_logo img,
        .head_top .bl_logo img,
        .head_logo img {
            max-width: 200px !important;
            max-height: 56px !important;
            height: auto !important;
            width: auto !important;
            display: inline-block !important;
        }
        .head_top .bl,
        .head_top .bl .fl_right,
        .head_top .fl_right,
        .head_top .fl_left {
            float: none !important;
            display: flex !important;
            justify-content: center !important;
            align-items: center !important;
            gap: 8px !important;
            flex-wrap: wrap !important;
            width: auto !important;
            max-width: 100% !important;
            margin: 0 auto !important;
            position: static !important;
        }
        .head_top .btn_sign,
        .head_top .mn_btn,
        .head_top a.btn_sign,
        .head_top a.mn_btn {
            font-size: 13px !important;
            padding: 8px 16px !important;
            margin: 0 !important;
            white-space: nowrap !important;
        }

        /* ─── HERO / SLOGAN WRAPPER ─── was position:absolute. */
        .wrap_header_cont,
        .wrap_header_cont.absolute,
        .wrap_header_cont_bl {
            position: relative !important;
            left: 0 !important; right: 0 !important; top: 0 !important;
            width: 100% !important;
            max-width: 100% !important;
            padding: 16px !important;
            box-sizing: border-box !important;
        }
        .wrap_header_cont .bl,
        .wrap_header_cont > .bl {
            width: 100% !important;
            padding: 0 !important;
            box-sizing: border-box !important;
        }

        /* ─── REGISTER + LOGIN PANELS ─── were 663px wide w/ 75px padding. */
        .steps, #step-1, #step-2, #step-3,
        .bl_form_registration, .bl_form_registration_step_1,
        .login_wrap, .fp_wrap, .obrd_wrap,
        .bl_help_public, .bl_help_member, .bl_contact_v2,
        .upg_pricing, .upg_included {
            max-width: 100% !important;
            width: calc(100vw - 24px) !important;
            margin: 12px auto !important;
            padding: 24px 18px !important;
            border-radius: 18px !important;
            box-sizing: border-box !important;
            min-height: auto !important;
        }
        .bl_form_registration h1,
        .bl_form_registration h2,
        .login_wrap h1, .fp_wrap h1, .upg_hero h1 {
            font-size: 22px !important;
            line-height: 1.3 !important;
            word-wrap: break-word !important;
            overflow-wrap: break-word !important;
            max-width: 100% !important;
        }

        /* ─── FOOTER ─── wrap items, no overflow. */
        .footer { padding: 0 !important; max-width: 100% !important; }
        .footer_w {
            padding: 14px 12px !important;
            max-width: 100% !important;
            box-sizing: border-box !important;
            text-align: center !important;
        }
        .footer_w ul.nav {
            display: flex !important;
            flex-wrap: wrap !important;
            justify-content: center !important;
            gap: 4px 8px !important;
            padding: 0 !important;
            margin: 0 0 8px !important;
        }
        .footer_w ul.nav li { font-size: 12px !important; padding: 0 !important; }
        .footer_w .title_orig {
            display: block !important;
            margin-top: 6px !important;
            font-size: 12px !important;
        }

        /* ─── LAYOUT TABLES (events, profile_view) ─── collapse to one column. */
        table.tb_events_new, table.profile_view_table,
        .events_new table, .frame_content table,
        .col_center table, .events_new_decor_l table {
            width: 100% !important;
            max-width: 100% !important;
            table-layout: fixed !important;
        }
        table.tb_events_new td, .events_new table td,
        .events_new_decor_l table td {
            display: block !important;
            width: 100% !important;
        }

        /* ─── INDIVIDUAL ELEMENTS ─── never let media or content blow out. */
        img, video, iframe, table, pre, code, blockquote,
        .pic, .photo, .avatar, .thumb {
            max-width: 100% !important;
            height: auto;
        }
        h1, h2, h3, h4, h5, h6, p, span, a, div, li, td, th {
            max-width: 100% !important;
            word-wrap: break-word !important;
            overflow-wrap: break-word !important;
        }

        /* ─── FORM CONTROLS ─── shouldn't exceed viewport. */
        input[type="text"], input[type="email"], input[type="password"],
        input[type="tel"], input[type="number"], input[type="search"],
        input[type="date"], textarea, select,
        .inp, .jq-selectbox, .jq-selectbox__select {
            width: 100% !important;
            max-width: 100% !important;
            box-sizing: border-box !important;
        }
        form[name="frm_date"], .bl_location {
            display: grid !important;
            grid-template-columns: repeat(3, 1fr) !important;
            gap: 8px !important;
            width: 100% !important;
        }

        /* ─── CSS BACKGROUND BLEED ─── the blue strip on the right. */
        .header, .main.above .wrapper {
            background-size: cover !important;
            background-position: center center !important;
            background-repeat: no-repeat !important;
            max-width: 100vw !important;
        }

        /* Common-but-rare absolute-positioned floating elements. */
        .pp_sign, .pp_resend_password,
        #pp_sign_in, #pp_resend_password,
        .popup, .pp_edit_info {
            max-width: calc(100vw - 24px) !important;
            margin: 12px auto !important;
            box-sizing: border-box !important;
        }
    }

    @media (max-width: 480px) {
        .head_top #logo_main_page,
        .head_top .blsss_logo img,
        .head_top .bl_logo img {
            max-width: 170px !important;
