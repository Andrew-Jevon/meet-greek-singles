	<!-- footer -->
    <!-- 2026-05-28 footer redesign per Irene's "wonderful, clear, smart" brief.
         Premium dating-site treatment: brand block on the left, organised link
         column on the right, trust-line + warm closing copy, cream-on-navy
         palette with a gold hairline divider. Replaces the flat pipe-separated
         link row. Mobile collapses both columns into a centered stack. -->
    <style>
        .mgs_footer {
            background: #0f3a6a;
            color: #f7f3ec;
            padding: 48px 0 32px;
            font-family: 'Lato', 'Inter', system-ui, sans-serif;
            position: relative;
        }
        .mgs_footer::before {
            content: '';
            position: absolute; top: 0; left: 50%; transform: translateX(-50%);
            width: 92%; max-width: 1080px; height: 1px;
            background: linear-gradient(90deg, transparent, rgba(200,154,58,0.55), transparent);
        }
        .mgs_footer_inner {
            max-width: 1080px;
            margin: 0 auto;
            padding: 0 32px;
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 48px;
            align-items: start;
        }
        .mgs_footer_brand {
            display: flex; flex-direction: column; gap: 10px;
        }
        .mgs_footer_brand_name {
            font-family: 'Playfair Display', Georgia, serif;
            font-size: 22px;
            font-weight: 600;
            color: #f3e3b8;
            letter-spacing: 0.4px;
            line-height: 1.1;
        }
        .mgs_footer_tagline {
            font-size: 14px;
            color: rgba(247,243,236,0.78);
            font-style: italic;
            max-width: 360px;
            line-height: 1.5;
            margin: 0;
        }
        .mgs_footer_heart {
            color: #c89a3a;
            font-size: 14px;
            display: inline-block;
            margin-right: 4px;
        }
        .mgs_footer_links {
            list-style: none;
            margin: 0; padding: 0;
            display: flex;
            flex-wrap: wrap;
            gap: 4px 22px;
            justify-content: flex-end;
        }
        .mgs_footer_links li { margin: 0; padding: 0; }
        .mgs_footer_links a {
            color: #f3e3b8;
            font-size: 14.5px;
            font-weight: 500;
            text-decoration: none;
            letter-spacing: 0.2px;
            padding: 4px 0;
            border-bottom: 1px solid transparent;
            transition: color 0.15s ease, border-color 0.15s ease;
            display: inline-block;
        }
        .mgs_footer_links a:hover {
            color: #ffffff;
            border-bottom-color: #c89a3a;
        }
        .mgs_footer_links li + li a::before {
            content: none;
        }
        .mgs_footer_bottom {
            max-width: 1080px;
            margin: 32px auto 0;
            padding: 24px 32px 0;
            border-top: 1px solid rgba(243,227,184,0.15);
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            justify-content: space-between;
            align-items: center;
            font-size: 13px;
            color: rgba(247,243,236,0.65);
        }
        .mgs_footer_copy { margin: 0; }
        .mgs_footer_close {
            font-style: italic;
            color: rgba(243,227,184,0.78);
        }
        @media (max-width: 768px) {
            .mgs_footer { padding: 36px 0 24px; }
            .mgs_footer_inner {
                grid-template-columns: 1fr;
                gap: 26px;
                text-align: center;
                padding: 0 22px;
            }
            .mgs_footer_links {
                justify-content: center;
                gap: 8px 18px;
            }
            .mgs_footer_brand { align-items: center; }
            .mgs_footer_tagline { margin: 0 auto; }
            .mgs_footer_bottom {
                margin-top: 26px;
                padding: 20px 22px 0;
                flex-direction: column;
                text-align: center;
                gap: 8px;
            }
        }
        /* Hide the legacy stock footer to avoid duplicate render on any page
           that still inlines the original markup somewhere upstream. */
        .footer .footer_w, .footer-ssl-seal { display: none !important; }
    </style>
    <div class="footer mgs_footer">
        <div class="mgs_footer_inner">
            <div class="mgs_footer_brand">
                <span class="mgs_footer_brand_name"><span class="mgs_footer_heart">&#9825;</span>Meet Greek Singles</span>
                <p class="mgs_footer_tagline">Serious connections for the Greek diaspora &mdash; rooted in shared heritage, culture, and values.</p>
            </div>
            <ul class="mgs_footer_links">
                <!-- begin_bottom_menu -->
                <!-- begin_bottom_menu_item -->
                <li>
                    <a <!-- begin_bottom_menu_item_target -->target="_blank"<!-- end_bottom_menu_item_target --> href="{url_main}{bottom_menu_item_url}">{bottom_menu_item_title}</a>
                </li>
                <!-- end_bottom_menu_item -->
                <!-- end_bottom_menu -->
            </ul>
        </div>
        <div class="mgs_footer_bottom">
            <span class="mgs_footer_copy">&copy; {year} Meet Greek Singles. All rights reserved.</span>
            <span class="mgs_footer_close">Made with care for the Greek world.</span>
        </div>
        <div class="footer_w" style="display:none;">
            <ul class="nav">
                <!-- begin_bottom_menu -->
                <!-- begin_bottom_menu_item -->
                <li>
                    <!-- begin_bottom_menu_item_stick -->
                    <span>|</span>
                    <!-- end_bottom_menu_item_stick -->
                    <a <!-- begin_bottom_menu_item_target -->target="_blank"<!-- end_bottom_menu_item_target --> href="{url_main}{bottom_menu_item_url}">{bottom_menu_item_title}</a>
                </li>
                <!-- end_bottom_menu_item -->
                <!-- end_bottom_menu -->
            </ul>
            <span class="title_orig">{l_footer_c}{title_orig} {year}</span>
        </div>
        <div class="footer-ssl-seal">{ssl_seal_html}</div>
	</div>
	<!-- /footer -->
</div>
