                    <!-- end_bottom_visitor_menu_item_stick -->
                    <a <!-- begin_bottom_visitor_menu_item_target -->target="_blank"<!-- end_bottom_visitor_menu_item_target --> href="{url_main}{bottom_visitor_menu_item_url}">{bottom_visitor_menu_item_title}</a>
                </li>
                <!-- end_bottom_visitor_menu_item -->
            </ul>
            <!-- end_bottom_visitor_menu -->
            <span class="title_orig">{l_footer_c}{title_orig} {year}</span>
        </div>
        <div class="footer-ssl-seal" style="display:none;">{ssl_seal_html}</div>
	</div>
