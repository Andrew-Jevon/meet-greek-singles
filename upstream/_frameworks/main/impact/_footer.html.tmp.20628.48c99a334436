<script>
    function setPageBackgroundHeight() {
        if($('.bl_join_done').height()) {
            return;
        }

        var isLoginPage = $('.bl_form_registration').height();
        var contentHeight = $('.bl_logo').outerHeight(true) + parseInt($('.wrap_header_cont .bl').css('paddingTop'));
        if(isLoginPage) {
            contentHeight += $('.slogan').outerHeight(true) + $('.bl_form_registration').outerHeight(true);
        } else {
            contentHeight += $('#step-1').outerHeight(true);
        }

        $('.header, .cover, #bg_shadow').height(Math.max(contentHeight, $(window).height()));
    }
</script>

