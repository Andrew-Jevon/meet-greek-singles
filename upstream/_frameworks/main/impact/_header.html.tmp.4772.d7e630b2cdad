    <!-- begin_color_scheme_styles -->
    <style type="text/css">

        html{ background: {color_scheme_background_color_impact}; }
        body{ background: {color_scheme_background_color_impact}!important; }

        <!-- begin_color_scheme_styles_background_image -->
        body {background: transparent !important;}
        /*html, body {
            background-image: url({color_scheme_styles_background_image});
            background-size: cover;
            background-position: center top;
        }*/
        <!-- end_color_scheme_styles_background_image -->

        .header ul.nav li a { color: {color_scheme_header_text_color_impact} }
        .header ul.nav li a:hover, .header ul.nav li span { color: {color_scheme_header_text_color_hover_impact} }

        .column_main{background-color: {color_scheme_central_column_background_color_impact};}

        .column_main .col ul.nav li span.icon { background-image: url({url_tmpl_main}/images/menu_icons/{color_scheme_menu_icons_impact}); }

        #colfix_l, .colfix_r_bg, .colfix_r_bg_head { background-color: {color_scheme_column_background_color_impact} }
        .column_main .col ul.nav li a.menu_selected { background-color: {color_scheme_menu_selected_item_background_color_impact}; }

        .column_main .col ul.nav li a {
            color: {color_scheme_menu_text_color_impact};
            border-top-color: rgba({color_scheme_menu_item_border_top_color_rgba});
            border-bottom-color: rgba({color_scheme_menu_item_border_bottom_color_rgba});
        }
        .column_main .col ul.nav li a:hover, .column_main .col ul.nav li a.inactive:hover { color: {color_scheme_menu_text_hover_color_impact} }

        .column_main .col ul.nav li a.inactive {
            color: {color_scheme_menu_inactive_text_color_impact};
        }

        .column_main .col ul.nav li .count { color: {color_scheme_menu_counter_color_impact} }
        .column_main .col ul.nav li .count.decor { background-color: {color_scheme_menu_counter_background_color_impact} }

        .column_main .col .link a { color: {color_scheme_remove_ads_color_impact} }
        .column_main .col .link a:hover { color: {color_scheme_remove_ads_color_hover_impact} }
        .column_main .col .link a.link_show_banner.action_show {color: {color_scheme_menu_inactive_text_color_impact}}
        .column_main .col .link a.link_show_banner.action_show:hover {color: {color_scheme_menu_text_hover_color_impact} }

        .column_main .banner_header_bl a.link_show_banner { color: {color_scheme_remove_header_ads_color_impact} }
        .column_main .banner_header_bl a.link_show_banner:hover { color: {color_scheme_remove_header_ads_color_hover_impact} }

        .main .banner_footer_bl a.link_show_banner { color: {color_scheme_remove_footer_ads_color_impact} }
        .main .banner_footer_bl a.link_show_banner:hover { color: {color_scheme_remove_footer_ads_color_hover_impact} }

        .column_main .col .bl_visited_photo strong, .profile_sign .txt { color: {color_scheme_column_text_color_impact} }

        .footer .nav li, .footer .nav li a, .column_lang_bl .column_lang a.language, .visitor_page .header a.btn_sign, .visitor_page .header .lang a.language, .visitor_page .header span.link { color: {color_scheme_footer_menu_color_impact} }
        .column_lang_bl .column_lang a.language::after{ border-bottom: 6px solid {color_scheme_footer_menu_color_impact}; }
        .footer .nav li a:hover, .column_lang_bl .column_lang a.language:hover { color: {color_scheme_footer_menu_color_hover_impact} }
        .column_lang_bl .column_lang a.language:hover::after{ border-bottom: 6px solid {color_scheme_footer_menu_color_hover_impact}; }

        .footer_w, .footer-ssl-seal{ color: {color_scheme_footer_copyright_color_impact} }

        button.btn.pink.btn_question { background: {color_scheme_join_button_no_background_color_impact}; color: {color_scheme_join_button_no_text_color_impact}; }
        button.btn.pink.btn_question:hover { background: {color_scheme_join_button_no_background_color_hover_impact}; }

        button.btn.lblue{ background: {color_scheme_button_secondary_2_background_color_impact}; color: {color_scheme_button_secondary_2_text_color_impact}; }
        button.btn.lblue:hover { background: {color_scheme_button_secondary_2_background_color_hover_impact}; }

        button.btn.btn_secondary_3{ background: {color_scheme_button_secondary_3_background_color_impact}; color: {color_scheme_button_secondary_3_text_color_impact}; }
        button.btn.btn_secondary_3:hover { background: {color_scheme_button_secondary_3_background_color_hover_impact}; }


        button.btn.turquoise.btn_question { background: {color_scheme_join_button_yes_background_color_impact}; color: {color_scheme_join_button_yes_text_color_impact}; }
        button.btn.turquoise.btn_question:hover { background: {color_scheme_join_button_yes_background_color_hover_impact}; }

        button.btn.btn_submit_upgrade { background: {color_scheme_button_upgrade_background_color_impact}; color: {color_scheme_button_upgrade_text_color_impact}; }
        button.btn.btn_submit_upgrade:hover { background: {color_scheme_button_upgrade_background_color_hover_impact}; }

        button.btn.like_frame {background: {color_scheme_button_like_background_color_impact}; border: 1px solid {color_scheme_button_like_border_color_impact}; color: {color_scheme_button_like_text_color_impact};}
        button.btn.like_frame:hover {background: {color_scheme_button_like_background_color_hover_impact}; border: 1px solid {color_scheme_button_like_border_color_hover_impact};}
        button.btn.like_frame.active{background: {color_scheme_button_active_like_background_color_impact}; border: 1px solid {color_scheme_button_active_like_background_color_impact};}
        button.btn.like_frame.active:hover{background: {color_scheme_button_active_like_background_color_hover_impact}; border: 1px solid {color_scheme_button_active_like_background_color_hover_impact};}


        button.btn.btn_open_im_top{background: {color_scheme_button_message_background_color_impact}; color:{color_scheme_button_message_text_color_impact};}
        button.btn.btn_open_im_top:hover{background: {color_scheme_button_message_background_color_hover_impact};}
        button.btn.btn_open_im_top .border_decor{border-bottom: 6px solid {color_scheme_button_message_reply_rate_background_color_impact};}

        button.btn.btn_open_im_bottom{background: {color_scheme_button_message_bottom_background_color_impact}; color:{color_scheme_button_message_bottom_text_color_impact};}
        button.btn.btn_open_im_bottom:hover{background: {color_scheme_button_message_bottom_background_color_hover_impact};}

        .tabs_profile .col_right .btn_browse_invisibly{background: {color_scheme_button_invisible_mode_background_color_impact} url({url_tmpl_main}/images/arrow_browse_invisibly.png) 95% 50% no-repeat; color: {color_scheme_button_invisible_mode_text_color_impact};}
        .tabs_profile .col_right .btn_browse_invisibly:hover{background: {color_scheme_button_invisible_mode_background_color_hover_impact} url({url_tmpl_main}/images/arrow_browse_invisibly.png) 95% 50% no-repeat; }

        .bl_browse .bl_filter{background: {color_scheme_search_filter_background_color_impact};}
        .bl_browse .bl_filter .filter_extended{background: {color_scheme_search_extended_filter_background_color_impact};}

        .chat .head a { background-color: {color_scheme_chat_header_background_color_impact}; color: {color_scheme_chat_header_text_color_impact}; }
        .chat .head span.marker { background-color: {color_scheme_chat_header_icon_color_impact}; }

        .chat.active .head a, .open_im_more_bl, .open_im_more ul.open_im_more_list li:last-child::after,
        .open_im_more ul.open_im_more_list{ background-color: {color_scheme_chat_online_header_background_color_impact}; color: {color_scheme_chat_online_header_text_color_impact}; }

        .chat.open .cont .item .message .msg_check,
        .chat.active .head a:hover, .open_im_more_bl:hover,
        .open_im_more ul.open_im_more_list li:last-child:hover::after,
        .open_im_more ul.open_im_more_list li:hover{ background-color: {color_scheme_chat_online_header_background_color_hover_impact}; }

        .chat.open .foot .pp_message_upload_img i.fa-camera{ color: {color_scheme_chat_online_header_background_color_hover_impact}; }
        .chat.open .foot .pp_message_upload_img .pp_message_upload_img_loader .spinner-blade{
            background-color: {color_scheme_chat_online_header_background_color_hover_impact};
        }

        @-webkit-keyframes open_im_head_blink {
            0% {background-color: {color_scheme_chat_online_header_background_color_impact};}
            50% {background-color: {color_scheme_chat_online_header_background_color_hover_impact_darker};}
            100% {background-color: {color_scheme_chat_online_header_background_color_impact};}
        }
        @keyframes open_im_head_blink {
            0% {background-color: {color_scheme_chat_online_header_background_color_impact};}
            50% {background-color: {color_scheme_chat_online_header_background_color_hover_impact_darker};}
            100% {background-color: {color_scheme_chat_online_header_background_color_impact};}
        }

        .chat.open .cont .item .message .msg_check.msg_arrow:after {
            border-left-color:{color_scheme_chat_online_header_background_color_hover_impact};
        }

        .chat.active .head span.marker { background-color: {color_scheme_chat_online_header_icon_color_impact}; }

        .chat.noactive .head a { background-color: {color_scheme_chat_offline_header_background_color_impact}; color: {color_scheme_chat_offline_header_text_color_impact}; }
        .chat.noactive .head a:hover { background-color: {color_scheme_chat_offline_header_background_color_hover_impact}; }
        .chat.noactive .head span.marker { background-color: {color_scheme_chat_offline_header_icon_color_impact}; }

        .chat .cont .chat_cont .item { color: {color_scheme_chat_online_header_background_color_impact}; }
        .chat .cont .chat_cont .item:hover { background-color: {color_scheme_chat_online_header_background_color_impact}; color: {color_scheme_chat_online_header_text_color_impact}; }

        .bl_ads { color: {color_scheme_menu_text_color_impact}; }

        .pagination a.disabled:hover, .pagination a.disabled {
            color: {color_scheme_pagination_disabled_item_color_impact};
        }

        .pagination a:hover, .pagination .pagination-active {
            color: {color_scheme_pagination_active_item_text_color_impact};
        }

        .pagination a:before {
            background-color: {color_scheme_pagination_active_item_background_color_impact};
        }

        .pagination a {
            color: {color_scheme_pagination_inactive_item_text_color_impact};
        }
        .pp_info_start.pp_alert.pp_confirm.pp_cont {
            background: #142d69;
            color: #fff;
        }

        button.confirm_ok.btn.small.marsh {
            background: linear-gradient(135deg,#f0d96a 0%,#c9a84c 50%,#8e6418 100%);
        }
    </style>
    <!-- end_color_scheme_styles -->

