        var urlPageLogin='{url_page_login}';
        var urlPageUpgrade='{url_page_upgrade}';
        var urlPageProfile='{url_page_profile_view}';
        var currentPage='{url_page}';
        var activePage='{current_page}';

        var isPlayerNative='{is_player_native}'*1;
        var isPageProfile=false;
		var isCurUserSuperPowers='{is_super_powers}'*1;

        // Server
