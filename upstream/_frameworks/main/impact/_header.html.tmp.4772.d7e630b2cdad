            };
			upgrade.setData({live_price : '{live_price}'*1})

        var messages = new CMessages('{user_id}', '{im_history_messages}');
            messages.maxFileSize = '{max_filesize}'*1;
            messages.langParts = {
                'really_delete_all_messages' : '{j_really_delete_all_messages}',
