<head>
	<title>{title}</title>
	<!-- begin_base_url_main_head -->
	<base href="{base_url_main_head}">
	<!-- end_base_url_main_head -->

	<!-- 2026-05-29 — robust login submit fallback. Chameleon's vendor
	     login_form.js relies on jquery.form's $.fn.ajaxSubmit. When that
	     plugin loads after the user has already submitted, OR is broken by
	     a stale cache, the form native-submits to /ajax.php and the user
	     sees raw "#js:logged:<name>" text in the URL bar instead of being
	     redirected. This handler binds in CAPTURE phase so it runs BEFORE
	     any vendor jQuery handler, intercepts the submit, sends the POST
	     via fetch(), and follows the same redirect logic the vendor's
	     loginResponse() uses. If the page already has a working vendor
	     handler, ours runs first and short-circuits it cleanly. -->
	<script>
	(function () {
		function handleResp(text) {
			if (text.indexOf('#js:logged:') === 0) {
				window.location.href = '/';
				return;
			}
			if (text.indexOf('#js:error:') === 0) {
				var msg = text.substring(10);
				var form = document.getElementById('form_login');
				var errEl = form && form.querySelector('.error');
				if (errEl) {
					errEl.textContent = msg;
					errEl.style.display = 'block';
					errEl.classList && errEl.classList.add('to_show');
				} else {
					alert(msg);
				}
				var inputs = form && form.querySelectorAll('input, button');
				if (inputs) Array.prototype.forEach.call(inputs, function (el) { el.disabled = false; });
				return;
			}
			window.location.href = '/';
		}
		function bind() {
			var form = document.getElementById('form_login');
			if (!form || form.__mgsLoginBound) return;
			form.__mgsLoginBound = true;
			form.addEventListener('submit', function (e) {
				e.preventDefault();
				e.stopImmediatePropagation();
				var fd = new FormData(form);
				if (!fd.has('ajax')) fd.set('ajax', '1');
				fetch(form.action || './ajax.php', {
					method: 'POST',
					body: fd,
					credentials: 'same-origin',
					headers: { 'X-Requested-With': 'XMLHttpRequest' }
				}).then(function (r) { return r.text(); })
				  .then(handleResp)
				  .catch(function () { window.location.href = '/'; });
				return false;
			}, true);
		}
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', bind);
		} else {
			bind();
		}
		// Re-attempt after a beat in case the form is injected later.
		setTimeout(bind, 800);
	})();
	</script>

	<!-- 2026-05-28 — hide social-login UI + the stray "OR" divider on
	     login/register/footer login forms. Social login (firstC.md
	     Phase 11) is currently deferred; without configured providers
	     the social-buttons UL is empty and the OR sits alone between
	     blank space and the email form. Remove this <style> block once
	     Phase 11 ships with real provider credentials. -->
	<style id="mgs-hide-social-login">
		.bl_social_buttons,
		.line_or,
		.login_form .or,
		.lp_bl .or,
		.fp_form .or,
		.bl_form_registration .part.br,
		.bl_form_registration .part.br p,
		.bl_form_registration .line_or { display: none !important; }
	</style>

