                <!-- end_header_menu_moderator -->
                <!-- begin_header_menu_moderator_selected -->
                <li class="selected"><span>{l_header_menu_moderator}</span></li>
                <!-- end_header_menu_moderator_selected -->
                <!-- end_header_menu_moderator_item -->

                <!-- begin_header_menu_sign_out_item -->
                <li><a onclick="Profile.confirmLogout(); return false;" href="">{l_header_menu_sign_out}</a></li>
                <!-- end_header_menu_sign_out_item -->

                <!-- end_header_menu_impact -->
            </ul>
        </div>
	</div>
	<!-- /header -->

	<!-- content -->

    <div class="content">
        <div class="cont_w">
            <div class="column_main">
    <!-- end_header_member -->

    <!-- begin_header_visitor_page -->
    <!-- wrapper -->
    <div class="wrapper">
    <!-- header -->
	<div class="header">
        <div class="header_w">
			<div class="wrap_logo">
                <a href="/" class="logo" title="Meet Greek Singles — Home">
                    <img src="{header_url_logo_inner}" alt="Meet Greek Singles" />
                </a>
            </div>
            <div id="fl_right_sign_in" class="fl_right" style="opacity:0;">
                <span class="link">{l_have_an_account}</span>
                <a class="btn_sign" href="{url_main}{url_page_login}">{l_sign_in}</a>
                <script>
                var pageUrlWithoutLanguage = '{page_url}';
                </script>
                <!-- begin_show_lang_top -->
                <div id="main_page_language" class="lang main_page_language">
                        <div class="main_page_language_bl">
                        <a class="language" onclick="return false;" href="">{lang_top_current}</a>
                        <div class="lang_item" id="main_page_language_item">
                            <ul class="pp_small" id="pp_language" >
                                <!-- begin_lang_top -->
                                <li><a href="#" onclick="siteSetLanguage('{lang_top_value}'); return false;"><span class="{lang_top_class}">{lang_top_title}</span></a></li>
                                <!-- end_lang_top -->
                            </ul>
                        </div>
                        </div>
                </div>
                <!-- end_show_lang_top -->
                <script>prepareLang();</script>
            </div>
        </div>
	</div>
	<!-- /header -->
	<!-- content -->
    <div class="content">
        <div class="cont_w">
            <div class="column_main">
    <!-- end_header_visitor_page -->
    <!-- begin_banner_header_bl -->
    <div class="banner_header_bl {banner_header_class}">
    <!-- begin_banner_header -->
    <div class="banner_header <!-- begin_banner_header_list_hide -->banner_hidden<!-- end_banner_header_list_hide -->">
        {banner_header}
    </div>
    <!-- end_banner_header -->
    <!-- begin_banner_header_list_action -->
    <div class="banner_header_remove link">
    <a class="link_show_banner <!-- begin_banner_header_show -->action_show<!-- end_banner_header_show -->" href="" onclick="Profile.visibleBanners($(this), 'content'); return false;">{banner_header_title}</a>
    </div>
    <!-- end_banner_header_list_action -->
    </div>
    <!-- end_banner_header_bl -->

<!-- 2026-05-08: prelaunch redirect cleanup. The server-side prelaunch gate
     302's blocked URLs back to '/?__plfb=1' (the __plfb sentinel prevents
     redirect-loops on Chameleon's auto-toHomePage). To the user this looks
     like "I clicked Search and nothing happened" since the URL silently
     becomes the homepage with a strange flag. This script: (1) rewrites the
     visible URL back to clean '/' via history.replaceState, (2) shows a
     calm toast explaining the bounce. Server flag still works exactly as
     before — we're only cleaning the user-visible side. -->
<style>
.mgs_prelaunch_toast {
    position: fixed;
    bottom: 28px;
    left: 50%;
    z-index: 99999;
    transform: translateX(-50%) translateY(80px);
    background: rgba(15, 58, 106, 0.94);
    color: #f7f3ec;
    padding: 13px 24px;
    border-radius: 999px;
    border: 1px solid rgba(184, 138, 62, 0.42);
    font-family: 'Source Sans 3', system-ui, -apple-system, sans-serif;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.2px;
    box-shadow: 0 8px 24px rgba(15, 58, 106, 0.28);
    opacity: 0;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.3s ease;
    pointer-events: none;
    max-width: calc(100vw - 32px);
    text-align: center;
}
.mgs_prelaunch_toast.is-visible {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
}
</style>
<script>
(function() {
    try {
        var u = new URL(window.location.href);
        if (u.searchParams.get('__plfb') !== '1') return;
        // Strip the flag from the visible URL without reloading
        u.searchParams.delete('__plfb');
        var clean = u.pathname + (u.search ? u.search : '') + (u.hash || '');
        if (window.history && window.history.replaceState) {
            window.history.replaceState(null, '', clean);
        }
        // Show a calm toast so the user understands what happened
        function showToast() {
            var t = document.createElement('div');
            t.className = 'mgs_prelaunch_toast';
            t.setAttribute('role', 'status');
            t.textContent = "This feature opens at launch — we're nearly there.";
            document.body.appendChild(t);
            // Trigger transition on next frame
            requestAnimationFrame(function() { t.classList.add('is-visible'); });
            setTimeout(function() { t.classList.remove('is-visible'); }, 4200);
            setTimeout(function() { if (t.parentNode) t.parentNode.removeChild(t); }, 4800);
        }
        if (document.body) {
            showToast();
        } else {
            document.addEventListener('DOMContentLoaded', showToast);
        }
    } catch (e) { /* never let the toast block page rendering */ }
})();
</script>