        if(name) {
            bgLast = name;
            var bgLastParts = bgLast.split(',');
            var bgLastUrl = bgLastParts[0];
            //console.log('BG LAST', bgLastUrl);
             document.documentElement.style.background='url('+bgLastUrl+') center top / cover transparent';
         }
 	</script>
