    <script>
    jQuery(document).ready(function(){
        var path = (window.location.pathname || '/').replace(/\/+$/, '') || '/';
        if (/^\/join2?(\/|$)/.test(path)) {
            document.body.classList.add('joinpage');
        }
        if (path === '/' || path === '/index.php') {
            document.body.classList.add('mgs_homepage');
            jQuery('.mgs_nav .mgs_nav_item').first().addClass('mgs_nav_active');
        }
    });
    </script>
    {xajax_js}
    {custom_head}

    <!-- ────────────────────────────────────────────────────────────────────
         SITE-WIDE MOBILE-SAFETY LAYER (in <head> → applies before first paint
         so phones never see desktop layout flash).
         Uses `html body` selector prefix everywhere to bump specificity
         above the body inline `!important` rules in register.html / etc.
         ──────────────────────────────────────────────────────────────────── -->
    <style id="impact-mobile-safety-head">
        html, body {
            max-width: 100vw !important;
            overflow-x: hidden !important;
        }

        /* ──────────────────────────────────────────────────────────────────
           MGS NAVBAR (per Irene's mockup 2026-04-27).
           Cream-ivory bar with logo + tagline (left), 7-item nav (centre),
           Log In + Join Now buttons (right). Replaces the legacy navy
           "head_top.absolute" header on every page.
           ────────────────────────────────────────────────────────────────── */
        body.visitor_page { background: #f7f3ec !important; }

        html body .mgs_navbar_container {
            background: #f7f3ec !important;
            border-bottom: 1px solid #e8e1d2 !important;
            position: relative !important;
            z-index: 30 !important;
            padding: 0 !important;
            max-width: 100% !important;
        }
        html body .mgs_navbar {
            position: relative !important;
            top: auto !important; left: auto !important; right: auto !important;
            display: flex !important;
            align-items: center !important;
            justify-content: space-between !important;
            gap: 24px !important;
            max-width: 1280px !important;
            margin: 0 auto !important;
            padding: 14px 24px !important;
            background: transparent !important;
            box-sizing: border-box !important;
            float: none !important;
        }
        html body .mgs_navbar .mgs_brand {
            display: flex !important;
            flex-direction: column !important;
            align-items: flex-start !important;
            gap: 0 !important;
            text-decoration: none !important;
            line-height: 1 !important;
            flex: 0 0 auto !important;
            float: none !important;
            cursor: pointer !important;
        }
        html body .wrap_logo .logo {
            display: inline-block !important;
            cursor: pointer !important;
            text-decoration: none !important;
        }
        /* 2026-05-08 per Irene: nudged the navbar logo +14% taller and +15%
           wider for more visual presence on desktop. Was 56/260, then 64/300.
           2026-06-09 (Q21): bumped to 80/360. 2026-06-12 (Q21 re-confirmed):
           Irene wants even bigger — pushing to 110/460 for prominent brand mark. */
        html body .mgs_navbar .mgs_brand_img {
            height: 110px !important;
            max-height: 110px !important;
            max-width: 460px !important;
            width: auto !important;
            display: block !important;
            margin: 0 !important;
        }
        html body .mgs_navbar .mgs_brand_tagline {
            font-family: 'Source Sans 3', system-ui, sans-serif !important;
            font-size: 9.5px !important;
            font-weight: 700 !important;
            letter-spacing: 2.4px !important;
            text-transform: uppercase !important;
            color: #b88a3e !important;
            margin-top: 4px !important;
            padding-left: 2px !important;
        }

        html body .mgs_nav {
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            gap: 26px !important;
            flex: 1 1 auto !important;
        }
        html body .mgs_nav .mgs_nav_item {
            color: #1f2937 !important;
            font-family: 'Source Sans 3', system-ui, sans-serif !important;
            font-size: 13px !important;
            font-weight: 600 !important;
            letter-spacing: 1px !important;
            text-transform: uppercase !important;
            text-decoration: none !important;
            padding: 8px 2px !important;
            border-bottom: 2px solid transparent !important;
            transition: color 0.15s ease, border-color 0.15s ease !important;
        }
        html body .mgs_nav .mgs_nav_item:hover {
            color: #14487f !important;
            border-bottom-color: #14487f !important;
            text-decoration: none !important;
        }
        html body .mgs_nav .mgs_nav_item.mgs_nav_active {
            color: #b88a3e !important;
            border-bottom-color: #b88a3e !important;
        }

        html body .mgs_nav_actions {
            display: flex !important;
            align-items: center !important;
            gap: 10px !important;
            flex: 0 0 auto !important;
            float: none !important;
            position: static !important;
        }

        /* 2026-06-09 (per Irene) — EN / ΕΛ language switcher in navbar.
           Subtle pill, gold separator, navy text on hover for active state. */
        html body .mgs_lang_switch {
            display: inline-flex !important;
            align-items: center !important;
            gap: 4px !important;
            padding: 6px 12px !important;
            border-radius: 999px !important;
            background: rgba(15, 58, 106, 0.05) !important;
            margin-right: 4px !important;
            font-family: 'Source Sans 3', system-ui, sans-serif !important;
            font-size: 12px !important;
            font-weight: 700 !important;
            letter-spacing: 0.8px !important;
        }
        html body .mgs_lang_btn {
            color: #5b6471 !important;
            text-decoration: none !important;
            padding: 2px 6px !important;
            border-radius: 4px !important;
            transition: color 0.15s ease, background 0.15s ease !important;
        }
        html body .mgs_lang_btn:hover {
            color: #0f3a6a !important;
            background: rgba(200, 154, 58, 0.18) !important;
            text-decoration: none !important;
        }
        html body .mgs_lang_btn.mgs_lang_active {
            color: #0f3a6a !important;
            background: rgba(200, 154, 58, 0.25) !important;
        }
        html body .mgs_lang_sep {
            color: #b88a3e !important;
            opacity: 0.7 !important;
        }
        html body .mgs_btn {
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            font-family: 'Source Sans 3', system-ui, sans-serif !important;
            font-weight: 600 !important;
            font-size: 13.5px !important;
            letter-spacing: 0.9px !important;
            text-transform: uppercase !important;
            text-decoration: none !important;
            padding: 11px 26px !important;
            border-radius: 999px !important;
            transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease !important;
            white-space: nowrap !important;
        }
        html body .mgs_btn_login {
            color: #14487f !important;
            background: #ffffff !important;
            border: 2px solid #b88a3e !important;
            box-shadow: 0 2px 10px rgba(15, 58, 106, 0.10) !important;
        }
        html body .mgs_btn_login:hover {
            background: #faf6ec !important;
            color: #0f3a6a !important;
            border-color: #b88a3e !important;
            transform: translateY(-1px) !important;
            box-shadow: 0 4px 14px rgba(15, 58, 106, 0.18) !important;
            text-decoration: none !important;
        }
        html body .mgs_btn_join {
            color: #ffffff !important;
            background: #0f3a6a !important;
            border: 2px solid #b88a3e !important;
            box-shadow: 0 2px 10px rgba(15, 58, 106, 0.25) !important;
        }
        html body .mgs_btn_join:hover {
            background: #b88a3e !important;
            border-color: #b88a3e !important;
            transform: translateY(-1px) !important;
            text-decoration: none !important;
            color: #ffffff !important;
            box-shadow: 0 4px 14px rgba(184, 138, 62, 0.35) !important;
        }

        /* Hide every legacy fragment of the old navy bar */
        html body .head_top.absolute,
        html body .bl_btn_app,
        html body .head_top a.btn_sign:not(.mgs_btn) { display: none !important; }

        /* Tablet — hide the centre nav, keep brand + buttons. Could become
           a hamburger later; for now we rely on the buttons + footer links. */
        @media (max-width: 980px) {
            html body .mgs_nav { display: none !important; }
            html body .mgs_navbar { padding: 10px 16px !important; gap: 12px !important; }
            html body .mgs_navbar .mgs_brand_img { height: 36px !important; max-height: 36px !important; }
            html body .mgs_navbar .mgs_brand_tagline { font-size: 8.5px !important; letter-spacing: 1.8px !important; }
            html body .mgs_btn { padding: 7px 16px !important; font-size: 12px !important; letter-spacing: 0.5px !important; }
        }
        @media (max-width: 480px) {
            html body .mgs_navbar { padding: 8px 12px !important; gap: 8px !important; }
            html body .mgs_navbar .mgs_brand_img { height: 32px !important; max-height: 32px !important; max-width: 130px !important; }
            html body .mgs_navbar .mgs_brand_tagline { font-size: 7.5px !important; letter-spacing: 1.4px !important; }
            html body .mgs_btn { padding: 6px 12px !important; font-size: 11.5px !important; }
        }
        /* ───────────────────────── /MGS NAVBAR ────────────────────────── */

        /* Footer was white-on-navy; now that body is cream, make footer
           text dark so the bottom links are actually readable. */
        html body .footer { background: transparent !important; }
        html body .footer_w {
            border-top: 1px solid #e8e1d2 !important;
            padding: 22px 16px 18px !important;
        }
        html body .footer_w .nav,
        html body .footer_w ul.nav { color: #5b6471 !important; }
        html body .footer_w .nav li,
        html body .footer_w ul.nav li,
        html body .footer_w ul.nav li a,
        html body .footer .nav li a,
        html body .footer_w span,
        html body .footer_w .title_orig {
            color: #5b6471 !important;
            font-family: 'Source Sans 3', system-ui, sans-serif !important;
            font-size: 13px !important;
        }
        html body .footer_w ul.nav li a:hover,
        html body .footer .nav li a:hover { color: #14487f !important; }
        html body .footer_w .title_orig {
            display: block !important;
            margin-top: 8px !important;
            color: #8a8f99 !important;
            font-size: 12px !important;
        }
        /* Legacy "main info" section (was 3 tiles, hidden on homepage but
           CSS var still tries to paint blue) — neutralise so it doesn't
           leave a coloured strip when present on member pages. */
        html body .bl_main_info .item p,
        html body .bl_main_info .item p strong { color: #1f2937 !important; }
        html body .content { background: transparent !important; }

        @media (max-width: 900px) {
            html body, html body .main, html body .wrapper, html body .header,
            html body .content, html body .cont_w, html body .col_center,
            html body .frame_content, html body .cs-container, html body .col_main,
            html body .column_main, html body .col.left, html body .col.right,
            html body #colfix_l, html body #colfix_l_bl, html body #colfix_r,
            html body #colfix_r_bl, html body .container, html body .page {
                max-width: 100% !important;
                min-width: 0 !important;
                width: auto !important;
                margin-left: auto !important;
                margin-right: auto !important;
                box-sizing: border-box !important;
            }

            html body .head_top, html body .head_top.absolute {
                position: relative !important;
                top: 0 !important; left: 0 !important; right: 0 !important;
                transform: none !important;
                width: 100% !important;
                max-width: 100% !important;
                padding: 12px 16px !important;
                text-align: center !important;
                box-sizing: border-box !important;
                display: flex !important;
                flex-direction: column !important;
                align-items: center !important;
                gap: 10px !important;
            }
            html body .head_top .blsss_logo,
            html body .head_top .bl_logo {
                display: block !important;
                margin: 0 auto !important;
                float: none !important;
                position: static !important;
            }
            html body .head_top #logo_main_page,
            html body .head_top .blsss_logo img,
            html body .head_top .bl_logo img,
            html body .head_top .logo img {
                max-width: 180px !important;
                max-height: 50px !important;
                height: auto !important;
                width: auto !important;
            }
            html body .head_top .bl,
            html body .head_top .fl_right,
            html body .head_top .fl_left {
                float: none !important;
                position: static !important;
                display: flex !important;
                justify-content: center !important;
                align-items: center !important;
                gap: 8px !important;
                flex-wrap: wrap !important;
                width: auto !important;
                max-width: 100% !important;
                margin: 0 auto !important;
            }
            html body .head_top .btn_sign,
            html body .head_top .mn_btn,
            html body .head_top a.btn_sign,
            html body .head_top a.mn_btn {
                font-size: 13px !important;
                padding: 8px 16px !important;
                margin: 0 !important;
                white-space: nowrap !important;
            }

            html body .wrap_header_cont,
            html body .wrap_header_cont.absolute {
                position: relative !important;
                top: 0 !important; left: 0 !important; right: 0 !important;
                width: 100% !important;
                max-width: 100% !important;
                padding: 16px !important;
                box-sizing: border-box !important;
            }
            html body .wrap_header_cont > .bl,
            html body .wrap_header_cont .bl {
                width: 100% !important;
                padding: 0 !important;
                box-sizing: border-box !important;
            }

            /* Sign-up panels (register.html / login / forget / onboarding) */
            html body .steps, html body #step-1, html body #step-2, html body #step-3,
            html body .bl_form_registration, html body .bl_form_registration_step_1,
            html body .login_wrap, html body .fp_wrap, html body .obrd_wrap,
            html body .bl_help_public, html body .bl_help_member, html body .bl_contact_v2,
            html body .upg_pricing, html body .upg_included {
                max-width: 100% !important;
                width: auto !important;
                margin-left: 8px !important;
                margin-right: 8px !important;
                margin-top: 12px !important;
                margin-bottom: 12px !important;
                padding: 22px 16px !important;
                border-radius: 18px !important;
                box-sizing: border-box !important;
                min-height: auto !important;
                left: auto !important;
                right: auto !important;
                position: relative !important;
            }
            html body section.steps,
            html body .steps.step-1,
            html body .steps.step-2 {
                /* Beat the inline `padding: 4.68rem 3.56rem` (~75px each side). */
                padding: 22px 16px !important;
                align-items: stretch !important;
            }
            html body .bl_form_registration h1,
            html body .bl_form_registration h2,
            html body .login_wrap h1, html body .fp_wrap h1, html body .upg_hero h1 {
                font-size: 22px !important;
                line-height: 1.3 !important;
                word-wrap: break-word !important;
                overflow-wrap: break-word !important;
                max-width: 100% !important;
            }

            /* /join2 — header logo + step + slogan stacked, not overlapping */
            html body .header > .step,
            html body .header > #join_step {
                position: relative !important;
                left: auto !important; top: auto !important;
                margin: 0 auto 8px !important;
                display: inline-block !important;
            }
            html body .header > .slogan {
                display: block !important;
                position: relative !important;
                left: auto !important; right: auto !important; top: auto !important;
                width: 100% !important;
                max-width: calc(100% - 32px) !important;
                margin: 8px auto !important;
                padding: 0 16px !important;
                font-size: 13px !important;
                line-height: 1.3 !important;
                box-sizing: border-box !important;
                text-align: center !important;
                color: #fff !important;
            }
            html body .header > .logo {
                position: relative !important;
                top: auto !important; right: auto !important;
                display: block !important;
                text-align: center !important;
                margin: 8px auto !important;
            }
            html body .header > .logo img {
                max-width: 160px !important;
                max-height: 40px !important;
            }
            /* /join2 question card — keep stock Chameleon visuals (white card,
               default fonts, default decorations). Only clamp width to fit the
               viewport so it stops overflowing horizontally on phones.        */
            html body .bl_card_question {
                width: auto !important;
                max-width: 100% !important;
                margin-left: 12px !important;
                margin-right: 12px !important;
                box-sizing: border-box !important;
            }
            html body .bl_card_question .card_question_cont {
                width: 100% !important;
                max-width: 100% !important;
                box-sizing: border-box !important;
            }
            html body .bl_card_question .card_question {
                max-width: 100% !important;
                box-sizing: border-box !important;
            }
            /* /join2 final step (Interested / About Me / Done / captcha) — stack */
            html body #full_step_3 .card_profile,
            html body .card_profile,
            html body .card_profile_info {
                display: block !important;
                width: 100% !important;
                max-width: 100% !important;
                box-sizing: border-box !important;
            }
            /* Force the parent to flex-centre the photo block, since
               `margin: auto` alone wasn't centring it inside the card. */
            html body #full_step_3 {
                display: flex !important;
                flex-direction: column !important;
                align-items: center !important;
                width: 100% !important;
                box-sizing: border-box !important;
            }
            html body #full_step_3 .card_profile {
                display: flex !important;
                flex-direction: column !important;
                align-items: center !important;
                width: 100% !important;
                max-width: 100% !important;
                box-sizing: border-box !important;
            }
            html body .card_profile .part_photo {
                display: flex !important;
                flex-direction: column !important;
                align-items: center !important;
                width: 100% !important;
                max-width: 280px !important;
                margin: 0 auto 18px !important;
                float: none !important;
                position: relative !important;
                z-index: 2 !important;
                text-align: center !important;
            }
            html body .card_profile .part_photo .upload_file,
            html body .card_profile .part_photo .upload {
                margin: 0 auto !important;
                float: none !important;
            }
            html body .card_profile .part_photo .name,
            html body .card_profile .part_photo .name_info {
                width: 100% !important;
                text-align: center !important;
                margin: 6px auto !important;
            }
            /* Hide the redundant join2 header logo on mobile — the global
               header (in _header.html) already shows it at the top of the
               page. Without this, the logo bleeds INTO the photo placeholder. */
            html body .bl_card_profile ~ .header > .logo,
            html body .header > .logo,
            html body div.header > div.logo {
                display: none !important;
            }
            /* Make sure the join2 .header (step+slogan only on mobile) sits
               in normal flow with proper spacing above the card. */
            html body .header {
                position: relative !important;
                padding: 14px 16px 18px !important;
                margin-bottom: 0 !important;
            }
            html body .card_profile_info,
            html body #frm_card_join {
                display: flex !important;
                flex-direction: column !important;
                gap: 14px !important;
                padding: 0 12px !important;
            }
            html body .card_profile_info .bl,
            html body #frm_card_join .bl {
                width: 100% !important;
                max-width: 100% !important;
                margin: 0 !important;
                box-sizing: border-box !important;
                display: block !important;
            }
            /* Captcha row — image stacks above the input, both visible. */
            html body #frm_card_join .bl .capcha,
            html body #frm_card_join .capcha,
            html body #frm_card_join .capcha_img {
                display: block !important;
                margin: 0 auto 10px !important;
                width: auto !important;
                max-width: 100% !important;
                position: static !important;
                float: none !important;
                background: transparent !important;
            }
            html body #frm_card_join .capcha img,
            html body #frm_card_join .capcha_img img,
            html body #img_join_captcha {
                display: block !important;
                margin: 0 auto !important;
                max-width: 200px !important;
                width: auto !important;
                height: auto !important;
                border: 1px solid #e8e1d2 !important;
                border-radius: 8px !important;
                background: #fff !important;
            }
            html body #frm_card_join .bl_inp_pos {
                width: 100% !important;
                margin-top: 6px !important;
            }
            html body #frm_card_join input.inp.capcha,
            html body #frm_card_join input#captcha {
                width: 100% !important;
                max-width: 100% !important;
                box-sizing: border-box !important;
                padding: 12px 14px !important;
                border: 1px solid #e1d8c2 !important;
                border-radius: 10px !important;
                font-size: 15px !important;
            }
            html body #join_done {
                display: block !important;
                width: calc(100% - 24px) !important;
                margin: 18px auto 0 !important;
                padding: 14px 20px !important;
                font-size: 16px !important;
                border-radius: 10px !important;
                background: #2c4a76 !important;
                color: #fff !important;
                font-weight: 600 !important;
            }
            html body #join_done:disabled {
                background: #c9c9c9 !important;
                color: #757575 !important;
                cursor: not-allowed !important;
            }
            /* Profile edit titles ("About Me" / "Interested in") + textareas */
            html body #frm_card_join .bl .title {
                font-family: 'Playfair Display', Georgia, serif !important;
                font-size: 17px !important;
                font-weight: 600 !important;
                color: #1f2937 !important;
                margin-bottom: 8px !important;
            }
            html body #frm_card_join textarea.fl_basic,
            html body #frm_card_join input.basic_field {
                width: 100% !important;
                box-sizing: border-box !important;
                min-height: 80px !important;
                padding: 12px 14px !important;
                border: 1px solid #e1d8c2 !important;
                border-radius: 10px !important;
                font-size: 15px !important;
                font-family: 'Source Sans 3', system-ui, sans-serif !important;
                resize: vertical !important;
            }
            html body #frm_card_join input.basic_field { min-height: 0 !important; }

            /* Footer wrapping */
            html body .footer { padding: 0 !important; max-width: 100% !important; }
            html body .footer_w {
                padding: 14px 12px !important;
                max-width: 100% !important;
                box-sizing: border-box !important;
                text-align: center !important;
            }
            html body .footer_w ul.nav {
                display: flex !important;
                flex-wrap: wrap !important;
                justify-content: center !important;
                gap: 4px 8px !important;
                padding: 0 !important;
                margin: 0 0 8px !important;
            }
            html body .footer_w ul.nav li { font-size: 12px !important; padding: 0 !important; }
            html body .footer_w .title_orig {
                display: block !important;
                margin-top: 6px !important;
                font-size: 12px !important;
            }

            /* Layout tables / event tiles */
            html body table.tb_events_new,
            html body .events_new table,
            html body .events_new_decor_l table {
                width: 100% !important;
                max-width: 100% !important;
                table-layout: fixed !important;
            }
            html body table.tb_events_new td,
            html body .events_new table td {
                display: block !important;
                width: 100% !important;
            }

            /* Generic content safety */
            html body img, html body video, html body iframe,
            html body table, html body pre, html body code {
                max-width: 100% !important;
                height: auto;
            }
            html body h1, html body h2, html body h3, html body h4,
            html body p, html body li, html body td {
                max-width: 100% !important;
                word-wrap: break-word !important;
                overflow-wrap: break-word !important;
            }

            /* Form controls */
            html body input[type="text"], html body input[type="email"],
            html body input[type="password"], html body input[type="tel"],
            html body input[type="number"], html body input[type="search"],
            html body textarea, html body select,
            html body .inp, html body .jq-selectbox, html body .jq-selectbox__select {
                width: 100% !important;
                max-width: 100% !important;
                box-sizing: border-box !important;
            }
            html body form[name="frm_date"], html body .bl_location {
                display: grid !important;
                grid-template-columns: repeat(3, 1fr) !important;
                gap: 8px !important;
                width: 100% !important;
            }

            /* Background image bleed kill */
            html body .header, html body .main.above .wrapper {
                background-size: cover !important;
                background-position: center center !important;
                max-width: 100vw !important;
            }
        }

        @media (max-width: 480px) {
            html body .head_top #logo_main_page,
            html body .head_top .blsss_logo img,
            html body .head_top .bl_logo img {
                max-width: 160px !important;
                max-height: 44px !important;
            }
            html body .head_top .btn_sign,
            html body .head_top .mn_btn {
                font-size: 12.5px !important;
                padding: 7px 14px !important;
            }
            html body .steps, html body #step-1, html body #step-2,
            html body .bl_form_registration,
            html body .login_wrap, html body .fp_wrap, html body .obrd_wrap {
                width: calc(100% - 16px) !important;
                padding: 20px 14px !important;
                border-radius: 14px !important;
            }
            html body .bl_form_registration h1,
            html body .bl_form_registration h2,
            html body .login_wrap h1, html body .fp_wrap h1 {
                font-size: 19px !important;
            }
            html body .bl_card_question .card_question {
                min-height: 180px !important;
                padding: 20px 16px !important;
            }
        }
    </style>
</head>
