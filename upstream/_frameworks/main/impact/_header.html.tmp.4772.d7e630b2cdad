    <!-- begin_color_scheme_styles_background_image_js -->
    <div class="profile_bg"></div>
    <script>
        if (user_profile_bg) {
            var $bgPage=$('.profile_bg');
            $(new Image()).load(function(){
                if(bgLast!=user_profile_bg){
                    var styleBg='url('+user_profile_bg+') center top / cover transparent';
                    $bgPage.oneTransEnd(function(){
                        //$('html').css({background:'transparent url('+user_profile_bg+')',backgroundSize:'cover', backgroundPosition:'center top'});
                        $('html').css('background', styleBg);
                        $bgPage.remove();
                    }).css({background:styleBg,opacity:1});
                }else{
                    $bgPage.remove();
                }
                name=user_profile_bg;
                //$('html').css({background:''});
                //bgLast=user_profile_bg;
            }).on('error', function(){
                name='';
                $('html').css({background:''});
                $bgPage.remove();
            }).prop('src', user_profile_bg)
        }
    </script>
    <!-- end_color_scheme_styles_background_image_js -->
	<!-- begin_header_visitor -->
    <!-- wrapper -->
    <div class="wrapper">
