{header}
<script>
    messages.setLastId('{last_id}');
    messages.initGeneral();
</script>
<style>
/* 2026-06-11 (per Irene): modernize the inbox list AND give it a 1000px
   min-height so the page has comfortable vertical presence even when the
   inbox is empty or has just a few threads. Scoped to .mgs_msg_list. */
.mgs_msg_list {
    padding-bottom: 56px !important;
    min-height: 1000px !important;
    position: relative !important;
    z-index: 1 !important;
    box-sizing: border-box !important;
}
.mgs_msg_list::after {
    content: '';
    display: block;
    clear: both;
    height: 0;
}
.mgs_msg_list .head.icon_head_messages {
    width: auto !important;
    max-width: 1000px !important;
    margin: 24px auto 0 !important;
    background: #ffffff !important;
    background-image: none !important;
    border-radius: 22px 22px 0 0 !important;
    padding: 22px 28px !important;
    border-bottom: 1px solid #e8e1d2 !important;
    position: relative !important;
    text-align: left !important;
    height: auto !important;
    line-height: 1.3 !important;
    font-family: 'Playfair Display', Georgia, serif !important;
    font-weight: 600 !important;
    font-size: 22px !important;
    color: #0f3a6a !important;
    box-shadow: 0 -4px 16px rgba(15, 58, 106, 0.04) !important;
}
.mgs_msg_list > .cont {
    width: auto !important;
    max-width: none !important;
    margin: 0 16px !important;
    background: #ffffff !important;
    border-radius: 0 0 22px 22px !important;
    border: 1px solid #e8e1d2 !important;
    border-top: none !important;
    box-shadow: 0 8px 24px rgba(15, 58, 106, 0.06) !important;
    padding: 20px !important;
    min-height: 500px !important;
    position: relative !important;
    z-index: 1 !important;
}
.mgs_msg_list .message_list { min-height: 400px; }
.mgs_msg_list #im_list_users_empty {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    min-height: 400px !important;
    text-align: center !important;
}
.mgs_msg_list #im_list_users_empty .bl_txt_msg_empty {
    font-family: 'Playfair Display', Georgia, serif !important;
    font-size: 18px !important;
    color: #5b6471 !important;
    margin-top: 12px !important;
}
</style>
<div class="col_center bl_message_list mgs_msg_list">
    <div class="head icon_head_messages">{l_messages}</div>
    <div class="cont">
        <div id="messages_box" class="message_list">
            {users_list}
        </div>
        <div id="loader_messages" class="css_loader loader_messages hidden">
            <div class="spinner center">
                <div class="spinner-blade"></div>
                <div class="spinner-blade"></div>
                <div class="spinner-blade"></div>
                <div class="spinner-blade"></div>
                <div class="spinner-blade"></div>
                <div class="spinner-blade"></div>
                <div class="spinner-blade"></div>
                <div class="spinner-blade"></div>
                <div class="spinner-blade"></div>
                <div class="spinner-blade"></div>
                <div class="spinner-blade"></div>
                <div class="spinner-blade"></div>
            </div>
        </div>
        <div id="im_list_users_empty">
		<div class="dialog pp_message_user_info">
            <div class="bl">
                <img src="{url_tmpl_main}images/decor_msg_empty.png" width="239" height="207" alt=""/>
                <div class="bl_txt_msg_empty"><span>{l_you_have_no_messages_yet}</span></div>
            </div>
        </div>
        </div>
        <div class="cl"></div>
    </div>
</div>
{footer}