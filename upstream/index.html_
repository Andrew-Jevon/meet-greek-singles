<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Meet Greek Singles</title>
<link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Poppins:ital,wght@0,300;0,400;0,500;1,400&family=Lora:ital,wght@0,400;1,400&display=swap" rel="stylesheet">
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }

html, body {
  height: 100%;
  font-family: 'Poppins', sans-serif;
}

.hero {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  background: #2a0a3a;
}

.hero-bg {
  position: absolute;
  inset: 0;
  background-image: url('cgm.png');
  background-size: cover;
  background-position: center top;
  z-index: 0;
}

.overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to right,
    rgba(10,5,20,0.35) 0%,
    rgba(10,5,20,0.18) 55%,
    rgba(10,5,20,0.03) 100%
  );
  z-index: 1;
}

/* Bokeh */
.bokeh { position:absolute; inset:0; z-index:2; pointer-events:none; overflow:hidden; }
.bokeh span { position:absolute; border-radius:50%; animation:bpulse 5s ease-in-out infinite; }
.bokeh span:nth-child(1)  { width:90px;  height:90px;  left:1%;   bottom:12%; background:radial-gradient(circle,rgba(255,210,80,.75),transparent 68%); animation-delay:0s; }
.bokeh span:nth-child(2)  { width:55px;  height:55px;  left:10%;  bottom:24%; background:radial-gradient(circle,rgba(255,200,60,.65),transparent 68%); animation-delay:.7s; }
.bokeh span:nth-child(3)  { width:75px;  height:75px;  left:5%;   bottom:4%;  background:radial-gradient(circle,rgba(255,220,95,.60),transparent 68%); animation-delay:1.4s; }
.bokeh span:nth-child(4)  { width:40px;  height:40px;  left:18%;  bottom:32%; background:radial-gradient(circle,rgba(255,205,70,.55),transparent 68%); animation-delay:.3s; }
.bokeh span:nth-child(5)  { width:60px;  height:60px;  left:14%;  bottom:8%;  background:radial-gradient(circle,rgba(255,215,85,.50),transparent 68%); animation-delay:2s; }
.bokeh span:nth-child(6)  { width:28px;  height:28px;  left:24%;  bottom:19%; background:radial-gradient(circle,rgba(255,200,60,.50),transparent 68%); animation-delay:1.1s; }
.bokeh span:nth-child(7)  { width:50px;  height:50px;  left:-1%;  bottom:38%; background:radial-gradient(circle,rgba(255,215,85,.45),transparent 68%); animation-delay:2.4s; }
.bokeh span:nth-child(8)  { width:34px;  height:34px;  left:28%;  bottom:6%;  background:radial-gradient(circle,rgba(255,210,75,.45),transparent 68%); animation-delay:.5s; }
.bokeh span:nth-child(9)  { width:20px;  height:20px;  left:21%;  bottom:43%; background:radial-gradient(circle,rgba(255,220,100,.40),transparent 68%); animation-delay:3s; }
.bokeh span:nth-child(10) { width:115px; height:115px; left:-3%;  bottom:1%;  background:radial-gradient(circle,rgba(255,190,50,.32),transparent 68%); animation-delay:1.7s; }
@keyframes bpulse {
  0%,100% { transform:scale(1);     opacity:.85; }
  50%      { transform:scale(1.13); opacity:1;   }
}

/* Page layout */
.page {
  position: relative;
  z-index: 3;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.topbar {
  padding: 22px 0 0;
  display: flex;
  justify-content: center;
}
.logo img {
  height: 68px;
  width: auto;
  filter: drop-shadow(0 2px 10px rgba(0,0,0,0.4));
}

.content-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10px 20px 0;
  width: 100%;
  text-align: center;
}

.heading-script {
  font-family: 'Great Vibes', cursive;
  font-size: clamp(50px, 6.5vw, 80px);
  color: #fff;
  line-height: 1.12;
  text-shadow: 0 2px 8px rgba(0,0,0,0.55);
  margin-bottom: 16px;
}

.subtitle {
  font-size: clamp(13px, 1.4vw, 15px);
  font-weight: 300;
  color: #fff;
  margin-bottom: 14px;
  text-shadow: 0 1px 6px rgba(0,0,0,0.5);
}

.launch {
  font-family: 'Lora', serif;
  font-style: italic;
  font-weight: 700;
  font-size: clamp(14px, 1.55vw, 17px);
  color: #fff;
  margin-bottom: 26px;
  line-height: 1.9;
  text-shadow: 0 1px 8px rgba(0,0,0,0.55);
}

/* ── FORM CARD with bottom vanish ── */
.form-card-wrap {
  width: 100%;
  max-width: 470px;
  position: relative;
}
.form-box {
    background: linear-gradient(
        to bottom,
        rgba(255, 255, 255, 1) 0%,
        rgba(255, 255, 255, 0) 100%
    );
    padding: 26px 24px 70px;
    border-radius: 16px;
    
    position: relative;
    overflow: hidden;
}

.input-row {
  position: relative;
  margin-bottom: 12px;
}
.input-row svg {
  position: absolute;
  left: 13px;
  top: 50%;
  transform: translateY(-50%);
  width: 15px; height: 15px;
  opacity: 0.38;
  pointer-events: none;
}

.form-box input {
  width: 100%;
  padding: 13px 14px 13px 38px;
  border: 1.5px solid #e8e0d0;
  border-radius: 8px;
  background: #faf8f5;
  font-family: 'Poppins', sans-serif;
  font-size: 14px;
  color: #555;
  outline: none;
  transition: border-color .2s, background .2s;
}
.form-box input::placeholder { color: #bbb; }
.form-box input:focus {
  border-color: #4a90d9;
  background: #fff;
}

.btn-notify {
  width: 100%;
  padding: 14px;
  border: none;
  border-radius: 30px;
  background: linear-gradient(90deg, #5ab4f8 0%, #2b6fbe 100%);
  color: #fff;
  font-family: 'Poppins', sans-serif;
  font-size: 16px;
  font-weight: 500;
  letter-spacing: 0.5px;
  cursor: pointer;
  box-shadow: 0 4px 18px rgba(43,111,190,0.45);
  transition: filter .2s, transform .15s;
  position: relative;
  z-index: 2; /* above the fade layer */
  margin-top: 2px;
}
.btn-notify:hover  { filter:brightness(1.08); transform:translateY(-1px); }
.btn-notify:active { filter:brightness(0.96); transform:translateY(0); }

.privacy {
  text-align: center;
  font-size: 12px;
  margin-top: 11px;
  color: #fff;
  position: relative;
  z-index: 2;
}

.success-msg {
  display: none;
  text-align: center;
  font-family: 'Lora', serif;
  font-size: 15px;
  font-weight: 600;
  color: #2a6e3a;
  padding: 10px 0 6px;
  position: relative;
  z-index: 2;
}

/* Responsive */
@media (max-width: 600px) {
  .topbar { padding-top: 16px; }
  .logo img { height: 56px; }
  .heading-script { font-size: 46px; }
  .content-area { padding: 8px 16px 0; }
  .form-box { padding: 20px 16px 65px; }
}
@media (max-width: 360px) {
  .heading-script { font-size: 38px; }
}
</style>
</head>
<body>

<div class="hero">
  <div class="hero-bg"></div>
  <div class="overlay"></div>

  <div class="bokeh" aria-hidden="true">
    <span></span><span></span><span></span><span></span><span></span>
    <span></span><span></span><span></span><span></span><span></span>
  </div>

  <div class="page">

    <div class="topbar">
      <div class="logo">
        <img src="https://meetgreeksingles.com/_files/logo/main_impact.png?v=1770033611" alt="Meet Greek Singles" />
      </div>
    </div>

    <div class="content-area">

      <h1 class="heading-script">You Asked.<br>We Listened.</h1>
      <p class="subtitle">Bringing romantic connections to Greek singles everywhere.</p>
      <p class="launch">We will be launching soon.<br>Join our list to be notified!</p>

      <div class="form-card-wrap">
        <form method="POST" action="notify.php">
        <div class="form-box">
          <div id="form-inner">

            <div class="input-row">
              <svg viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
              </svg>
              <input name="name" type="text" id="inp-name" placeholder="Name" autocomplete="name" />
            </div>

            <div class="input-row">
              <svg viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2"/>
                <path d="m22 7-10 7L2 7"/>
              </svg>
              <input name="email" type="email" id="inp-email" placeholder="Email Address" autocomplete="email" />
            </div>

            <button class="btn-notify" onclick="handleSubmit()">Notify Me</button>
            <p class="privacy">Your privacy is our priority.</p>

          </div>
          <div class="success-msg" id="success-msg">
            🎉 You're on the list! We'll notify you at launch.
          </div>
        </div>
        </form>
      </div>

    </div>
  </div>
</div>

 

</body>
</html>