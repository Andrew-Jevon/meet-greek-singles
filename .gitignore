# ─── Secrets / DB credentials (never commit) ───────────────────────────
.env
*.env
.env.*
*.pem
*.key
*.crt
_include/config/db.php
**/_include/config/db.php
**/db.php
**/config.php
**/settings.php

# ─── Huge, non-source artifacts (these blocked the original push) ──────
# _vendor_installer/chameleon_5.7.zip is 826 MB, _deploy_tars/*.tar up to 208 MB.
# They are the upstream product installer + per-deploy tarballs — not source.
_deploy_tars/
_vendor_installer/
_core_extract/*.zip
_core_extract/*.tar

# ─── Derived / runtime (regenerated by setup.ps1) ─────────────────────
_local_run/webroot/
_local_run/sessions/
_local_run/*.log
working/
__pycache__/
*.pyc

# ─── Editor / tooling temp files ──────────────────────────────────────
*.tmp
*.tmp.*
.vscode/
.idea/
.DS_Store
Thumbs.db

# ─── Runtime, USER-uploaded media (not brand assets) ──────────────────
# Brand assets under _files/logo, _files/banner, and the hero videos ARE tracked.
_files/cache/
_files/photo/
_files/video/
_files/user/
_uploads/
uploads/
_userfiles/

# ─── Dependencies ─────────────────────────────────────────────────────
node_modules/
vendor/

# ─── Scratch SQL/db probes at repo root (keep the real dump in db/) ───
/probe_*.sql
/cu.sql
/mk.sql
/flip_*.sql
ip.db
*.db

# NOTE: db/*.sql (the schema+seed dump) IS committed on purpose — it is
# needed for clone-and-run. Brand media in upstream/_files IS committed too.
